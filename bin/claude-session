#!/usr/bin/env bash
#
# claude-session — launch/attach a Claude Code session in tmux, with state-aware
# duplicate detection, multi-account support, and a rich `ls` / `doctor` view.
#
# Why tmux? The Claude process lives in tmux on this host so it survives SSH/
# VSCode tunnel disconnects. Any client (laptop, phone Termius, browser tunnel)
# can reattach to the same Claude. Inside Claude: /rc = phone Remote Control,
# /ide = VSCode diff view.
#
# Usage:
#   claude-session                 # project = current ~/<dir>; session <project>-claude
#   claude-session <project>       # ~/<project>;               session <project>-claude
#   claude-session <project> new   # next free <project>-claude-N (the iterator)
#   claude-session <project> <N>   # specific <project>-claude-N
#   claude-session new             # (from inside ~/<project>) next free numbered
#   claude-session ls              # just list: numbered cards + chat titles (no picker)
#   claude-session resume          # interactive picker: pick a chat to open/preview
#   claude-session doctor          # find duplicates, stalls, dead session files,
#                                  # orphaned dev processes (ppid=1), stuck builds
#   claude-session doctor --reap [--force]  # kill orphaned dev processes found above
#                                  # (confirms interactively; --force for unattended)
#   claude-session kill            # interactive: pick session(s) to kill, shows RAM
#   claude-session kill <session>  # tmux kill-session shortcut (direct)
#
#   claude-session accounts add <name> [description]  # register + interactive /login
#   claude-session accounts ls                         # list registered accounts
#   claude-session accounts rm <name>                  # unregister (keeps credentials on disk)
#
#   claude-session <native-claude-args>  # runs native claude: inline (exec) for
#                                         # one-shot verbs like `update`/`mcp`,
#                                         # tmux for interactive ones like `--resume`
#   claude-session -- <args>              # forces native routing (use for name
#                                         # clashes with our own verbs, e.g. `-- doctor`)
#                                         # both honor --account=
#
#   claude-session transfer [sessionId] --to=<account> [--from=<account>]
#                                       [--move] [--force] [--limit=N] [--launch]
#     Move one chat's on-disk state between accounts. Omit sessionId to pick from
#     a list of the source account's chats (every project, not just this dir;
#     50 most recent by default, --limit=0 for all). Copies by default; --move
#     removes the source afterwards. Pure data operation — never touches tmux.
#     Retiring the old session is a separate, deliberate `claude-session kill`.
#     --launch reopens the moved chat resumed in tmux under the destination account.
#
#   claude-session transfer log [--from=A --to=B --sid=S --since=DATE --limit=N]
#                                                  # show the transfer history (ledger)
#   claude-session transfer undo [sid|id]          # reverse the last (or named) transfer
#   claude-session transfer redo <id>              # re-apply a logged transfer
#   claude-session transfer prune <id>             # drop a ledger record (keeps chat data)
#
#   claude-session schedule add <prompt> (--chat=<sid>|--new)
#     (--every=<dur>|--daily-at=<HH:MM>|--once="<YYYY-MM-DD HH:MM>")
#     [--account=] [--mode=plan|autopilot] [--cwd=] [--timeout=]
#                                          # schedule a prompt via a systemd user timer
#   claude-session schedule ls|log <id>|rm <id>|run <id>
#                                          # list/inspect/remove/fire a scheduled prompt
#
# Flags: --force / -f   override the "already RC-bridged" guard
#                       (for `transfer`: allow overwriting at the destination)
#        --to=NAME      transfer destination account (required by `transfer`)
#        --from=NAME    transfer source account (default: default)
#        --move         transfer removes the source copy instead of keeping it
#        --limit=N      transfer picker: how many recent chats to list (0 = all)
#        --plain / -p   force non-interactive (no picker even in `resume`)
#        --reap         `doctor --reap`: kill orphaned dev processes (ppid=1)
#                       found by doctor; needs a TTY confirm or --force
#        --handoff=FILE read FILE as initial takeover context (any agent's handoff)
#        --mode=MODE    interactive, plan, or autopilot (maps to --permission-mode)
#        --account=NAME run under a registered account's isolated CLAUDE_CONFIG_DIR
#                       (session becomes <project>-claude-NAME); omit for the
#                       default account. See `claude-session accounts`.
#
# `ls` only prints the list. `resume` is the interactive launcher: numbered cards
# show each chat's title; type a number to open it, p<number> to preview it (uses
# fzf if present). `ls`/`doctor`/`resume`/`kill` cover every registered account —
# cards are tagged [account] unless it's the default one.

# Bash 4+ is required: `declare -A` (associative arrays) is used at top level, so
# a 3.2 shell dies before any dispatch with an opaque "declare: -A: invalid option".
if (( ${BASH_VERSINFO[0]:-0} < 4 )); then
  echo "claude-session: needs bash >= 4 (this is ${BASH_VERSION:-unknown})." >&2
  echo "  macOS ships bash 3.2. Install a newer one:  brew install bash" >&2
  echo "  then re-run — the shebang picks up the newer bash from PATH." >&2
  exit 1
fi

VERSION="0.2.0"
# The envelope schema version the --json emitters produce (lib/json.sh). Bumped
# only when a field is REMOVED or changes meaning — additions are forward-
# compatible by contract, so the Go binary ignores fields it does not know.
# tests/test_json.sh asserts this equals the binary's schemaMax by grepping both
# files, so bash↔Go skew is caught at build time rather than at runtime.
JSON_SCHEMA_VERSION=1

# Resolve our library directory from our own location, not from $HOME: the same
# file must work from an install prefix (../share/claude-helpers) and from a repo
# checkout (../lib), for any user. Minimal inline symlink resolution, because
# compat.sh (which provides _readlink_f) is not sourced yet.
_cs_self="${BASH_SOURCE[0]}"
while [[ -L "$_cs_self" ]]; do
  _cs_link="$(readlink "$_cs_self")"
  [[ "$_cs_link" == /* ]] && _cs_self="$_cs_link" || _cs_self="$(dirname "$_cs_self")/$_cs_link"
done
_CS_BIN_DIR="$(cd "$(dirname "$_cs_self")" && pwd)"
if [[ -z "${CLAUDE_HELPERS_LIB:-}" ]]; then
  for _cand in "$_CS_BIN_DIR/../share/claude-helpers" "$_CS_BIN_DIR/../lib"; do
    if [[ -f "$_cand/compat.sh" ]]; then CLAUDE_HELPERS_LIB="$(cd "$_cand" && pwd)"; break; fi
  done
fi
if [[ -z "${CLAUDE_HELPERS_LIB:-}" || ! -f "$CLAUDE_HELPERS_LIB/compat.sh" ]]; then
  echo "claude-session: cannot find its library directory." >&2
  echo "  looked next to $_CS_BIN_DIR (../share/claude-helpers, ../lib)" >&2
  echo "  set CLAUDE_HELPERS_LIB=/path/to/lib to override." >&2
  exit 1
fi

set -euo pipefail

. "$CLAUDE_HELPERS_LIB/compat.sh"
. "$CLAUDE_HELPERS_LIB/ui.sh"
. "$CLAUDE_HELPERS_LIB/titles.sh"
. "$CLAUDE_HELPERS_LIB/ledger.sh"
. "$CLAUDE_HELPERS_LIB/schedule.sh"
. "$CLAUDE_HELPERS_LIB/titleindex.sh"
. "$CLAUDE_HELPERS_LIB/json.sh"

# ---- account registry -------------------------------------------------------
# ~/.config/claude-helpers/accounts.conf registers extra Claude Code accounts,
# each isolated via its own CLAUDE_CONFIG_DIR. Same convention as services.conf:
# bash-sourced, one `account` call per line, re-read every invocation. The
# built-in "default" account (plain ~/.claude) always exists and is never in
# this file.
ACCOUNTS_CONF="$HOME/.config/claude-helpers/accounts.conf"
declare -A ACCT_DIR ACCT_DESC
ACCT_NAMES=()

# Called by accounts.conf for each registered account.
account() {
  local name="$1" dir="${2/#\~/$HOME}" desc="${3:-}"
  if [[ -z "$name" || "$name" == "default" || ! "$name" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    echo "claude-session: ignoring invalid account entry in $ACCOUNTS_CONF: '$name'" >&2
    return
  fi
  ACCT_NAMES+=("$name")
  ACCT_DIR[$name]="$dir"
  ACCT_DESC[$name]="$desc"
}

if [[ -f "$ACCOUNTS_CONF" ]]; then
  # shellcheck source=/dev/null
  . "$ACCOUNTS_CONF"
fi

# Resolve an --account= name to its CLAUDE_CONFIG_DIR override.
# Prints "" for empty/"default" (meaning: don't set CLAUDE_CONFIG_DIR at all).
# Returns 1 for an unrecognized name.
_account_config_dir() {
  local name="$1" n
  [[ -z "$name" || "$name" == "default" ]] && { printf ''; return 0; }
  for n in "${ACCT_NAMES[@]+"${ACCT_NAMES[@]}"}"; do
    [[ "$n" == "$name" ]] && { printf '%s' "${ACCT_DIR[$name]}"; return 0; }
  done
  return 1
}

# Account name -> its actual on-disk config dir, never empty ("default" -> ~/.claude).
# Used by the data layer (ls/doctor/resume), which always needs a concrete path.
_account_dir_or_default() {
  local name="${1:-default}"
  if [[ -z "$name" || "$name" == "default" ]]; then
    printf '%s' "$HOME/.claude"
  else
    printf '%s' "${ACCT_DIR[$name]:-$HOME/.claude}"
  fi
}

# name<TAB>config-dir for every account: synthetic "default" row first, then
# every registered account. Used to merge sessions across all accounts.
_all_accounts() {
  printf 'default\t%s\n' "$HOME/.claude"
  local n
  for n in "${ACCT_NAMES[@]+"${ACCT_NAMES[@]}"}"; do
    printf '%s\t%s\n' "$n" "${ACCT_DIR[$n]}"
  done
}

# Verbs whose --json emitter exists in this build. Appended to as each emitter
# lands. --json for anything else is a hard error: answering a --json request
# with the human box-drawn rendering would be a silently-wrong answer.
# "accounts" covers `accounts ls --json` (lib/json.sh's _json_section_accounts);
# "_snapshot" is the internal envelope verb, also from lib/json.sh; "_titles" is
# the lazy per-window title resolver (lib/titleindex.sh's _titles_window).
_JSON_READY_VERBS="accounts _snapshot _titles ls doctor"
_json_guard() {
  local verb="${1:-<none>}"
  (( JSON_OUT == 1 )) || return 0
  case " $_JSON_READY_VERBS " in *" $verb "*) return 0 ;; esac
  echo "claude-session: --json is not available for '$verb' in this build" >&2
  exit 2
}

# ---- session model ---------------------------------------------------------
# Emit one TSV row per session file, across every registered account:
#   tmux  pid  cwd  entry  status  sessionId  bridgeId  updatedMs  alive  account

# The raw per-file fields, in the order _session_rows consumes them. Kept as its
# own function so the fast batch path and the resilient per-file fallback below
# emit byte-identical output from one field list rather than two copies that can
# drift.
# EVERY field must be non-empty. Tab is IFS *whitespace*, so bash collapses a
# run of tabs into one delimiter: a single empty field silently shifts every
# later field left. That produced rows where the sessionId column held a
# timestamp, liveness flipped, and titles came from the wrong chat. The empty
# placeholder is '-' and the shell converts it back where an empty string is
# what the logic wants.
# `//` only substitutes for null and false — an empty STRING passes straight
# through it, which is how this shifted twice: first on a missing waitingFor,
# then on a bridgeSessionId written as "". `def d` collapses both cases, so the
# invariant "no field is ever empty" holds for every field by construction
# rather than per-field vigilance.
_SESSION_JQ='def d: if . == null or . == "" then "-" else . end;
             [ (.pid|d), (.cwd|d), (.entrypoint|d), (.status|d),
               (.waitingFor|d), (.sessionId|d), (.bridgeSessionId|d),
               ((.statusUpdatedAt // .updatedAt // .startedAt // 0)
                 | if . == null or . == "" then 0 else . end) ] | @tsv'

_session_fields_per_file() {
  local f
  for f in "$@"; do
    jq -r "$_SESSION_JQ" "$f" 2>/dev/null || true
  done
}

# Emit one TSV row per session file, across every registered account:
#   tmux  pid  cwd  entry  status  sessionId  bridgeId  updatedMs  alive  account
_session_rows() {
  shopt -s nullglob
  # Populate owner_tmux's lookup tables HERE, in this shell. Every owner_tmux
  # call below happens inside `$(...)`, i.e. a subshell — a cache it builds is
  # discarded when that subshell exits, so memoizing inside owner_tmux alone
  # buys nothing (measured: forks fell but wall time did not move at all).
  # Subshells inherit their parent's state, so loading once here is what
  # actually makes the cache visible to all of them.
  _ot_load
  local acct_name acct_dir
  while IFS=$'\t' read -r acct_name acct_dir; do
    local -a files=("$acct_dir/sessions"/*.json)
    # nullglob means no session files expands to nothing — and `jq` with no file
    # arguments reads STDIN, which would hang `ls` forever. Never let the glob
    # reach jq empty.
    (( ${#files[@]} )) || continue

    # One jq per ACCOUNT, not eight per FILE. This previously forked jq once per
    # field per file: 430 forks and ~6.5s of a 6.8s `ls` on this host. It is the
    # same anti-pattern as the per-pid `ps` fork that once made `ls` take 150s —
    # fixed there, never checked for here.
    local raw
    if ! raw="$(jq -rs ".[] | $_SESSION_JQ" "${files[@]}" 2>/dev/null)"; then
      # `jq -s` is all-or-nothing: one unparseable file would hide every session
      # for the account. These files are written live by Claude Code, so a torn
      # read is a real possibility — fall back to per-file so the damage stays
      # local to the bad file instead of blanking the account.
      raw="$(_session_fields_per_file "${files[@]}")"
    fi

    local pid cwd entry status waitfor sid bid updated alive sess
    while IFS=$'\t' read -r pid cwd entry status waitfor sid bid updated; do
      # '-' is the emitter's placeholder for "absent" (see _SESSION_JQ); turn it
      # back into the empty string only where the logic below tests emptiness.
      [[ "$pid" == "-" || -z "$pid" ]] && continue
      [[ "$waitfor" == "-" ]] && waitfor=""
      [[ "$status" == "waiting" && -n "$waitfor" ]] && status="waiting:$waitfor"
      [[ -z "$sid" ]] && sid="-"
      [[ -z "$bid" ]] && bid="-"
      if _proc_alive "$pid"; then alive=1; else alive=0; fi
      sess="$(owner_tmux "$pid")"
      [[ -z "$sess" && "$entry" == "claude-vscode" ]] && sess="(vscode)"
      [[ -z "$sess" ]] && sess="(detached)"
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$sess" "$pid" "$cwd" "$entry" "$status" "$sid" "$bid" "$updated" "$alive" "$acct_name"
    done <<<"$raw"
  done < <(_all_accounts)
}

# ---- enter / transcript helpers -------------------------------------------
# Enter a session. Inside tmux, `attach` is refused (no nesting) and would dump
# us back to the shell with the target left detached; switch-client moves the
# current client instead, so this works from anywhere.
_enter_session() {
  if [[ -n "${TMUX:-}" ]]; then
    echo "claude-session: inside tmux — switching client to '$1'" >&2
    exec tmux switch-client -t "$1"
  fi
  exec tmux attach -t "$1"
}






# RSS(KB) batch cache: one `ps -eo pid=,rss=` for every pid on the box instead
# of one `ps -p PID -o rss=` fork per row. `ls` calls _pid_ram_mb once per
# session card, so this is the same "single snapshot, once per invocation"
# idea as _ot_load in ui.sh (see its comment for why per-call caching, done
# via a normal function call rather than through `$(...)`, is what actually
# avoids the forks — a cache built inside a command-substitution subshell is
# discarded the moment that subshell exits).
# Only called from `cmd_ls`, a one-shot listing: `cmd_kill` is an open-ended
# interactive loop, and freezing every RAM figure at the moment it started
# would go stale while the user is still deciding — left alone on purpose.
declare -A _RAM_KB_CACHE
_RAM_LOADED=0
_ram_load() {
  (( _RAM_LOADED )) && return 0
  local pid rss
  while read -r pid rss; do
    [[ -n "$pid" ]] && _RAM_KB_CACHE[$pid]="$rss"
  done < <(ps -eo pid=,rss= 2>/dev/null || true)
  _RAM_LOADED=1
}

# PID -> current RSS in MB (returns 0 if process is gone). Reads the batch
# cache above when it has been loaded; otherwise falls back to a live per-pid
# `ps` so this stays correct on its own for any caller that never loads it.
_pid_ram_mb() {
  local rss
  if (( _RAM_LOADED )); then
    rss="${_RAM_KB_CACHE[$1]:-}"
  else
    rss="$(ps -p "$1" -o rss= 2>/dev/null | tr -d ' ')"
  fi
  [[ -z "$rss" ]] && echo 0 || awk -v r="$rss" 'BEGIN{printf "%.0f", r/1024}'
}

# ---- orphan process detection ----------------------------------------------
# A host once CPU-limited this box because 8 orphaned `medusa plugin:build`
# processes and 6 `npm run dev` trees kept spinning for hours: their parent
# tmux/claude session got killed, but children are NOT killed with the parent
# — they get reparented to init (ppid=1) and never stop on their own. None of
# this is visible in the Claude session-state JSON files _session_rows reads,
# so it needs its own OS-process scan, independent of any Claude session.
#
# Dev-runner command patterns and the protected (never-touch) daemon comm
# list. Protected is intentionally prefix-matched and generous: e.g. tmux's
# own server process renames itself "tmux: server" (a literal embedded space
# in its comm field), which our naive whitespace field-split below will
# split into comm="tmux:" + args="server ...". Prefix matching still catches
# it. Never risk a system daemon.
_ORPHAN_DEV_PATTERN='node|npm|npx|tsx|esbuild|vite|next|medusa|plugin:build|nodemon|webpack'
_ORPHAN_PROTECTED_PATTERN='^(tmux|claude|sshd|postgres|dockerd|containerd|systemd|earlyoom|ttyd|cloudflared|code|node_exporter)'

# Raw process snapshot, reformatted to TSV: pid<TAB>ppid<TAB>etimes<TAB>pcpu<TAB>comm<TAB>args
# Reads $ORPHAN_PS_SRC (a file, real ps field order) when set — so tests are
# fully deterministic and never touch the real process table. Otherwise runs
# real `ps` with the exact field layout this parsing depends on.
_ps_snapshot_rows() {
  if [[ -n "${ORPHAN_PS_SRC:-}" ]]; then
    local src; src="$(cat "$ORPHAN_PS_SRC" 2>/dev/null || true)"
    [[ -z "$src" ]] && return 0
    awk '{
      pid=$1; ppid=$2; etimes=$3; pcpu=$4; comm=$5
      args=""
      for (i=6;i<=NF;i++) args = args (i>6?" ":"") $i
      printf "%s\t%s\t%s\t%s\t%s\t%s\n", pid, ppid, etimes, pcpu, comm, args
    }' <<<"$src"
    return 0
  fi
  # Real process table, via the portability shim (compat.sh): _proc_table emits
  # the identical 6-field TSV (pid, ppid, elapsed-seconds, pcpu, comm, args) —
  # `ps -o etime=` (parsed to seconds) in place of the Linux-only `ps -eo
  # etimes=` field, and `ps -o comm= -p <pid>` (portable on both platforms) in
  # place of reading the per-pid comm file that only exists under Linux's
  # /proc, with the same comm-can-contain-spaces handling either way. No
  # downstream change needed: _orphan_rows/_stuck_build_rows/_orphan_activity
  # only ever consume this TSV.
  _proc_table
}

# One TSV row per orphaned dev process: pid<TAB>etimes<TAB>pcpu<TAB>comm<TAB>args
# Orphan = ppid==1, owned by us, older than 300s, matches a dev-runner pattern
# (or is an orphaned Claude shell-snapshot wrapper), and isn't a protected
# daemon. The real `ps -e -u` combo is a union (not an intersection) on this
# box's procps, so `-u` alone doesn't actually filter by owner — we re-verify
# ownership ourselves via _proc_owner_uid when running against the real
# process table (skipped for $ORPHAN_PS_SRC fixtures, which have no real pids
# to query).
#
# Optional $1 = a pre-computed _ps_snapshot_rows result. _doctor_warnings
# needs BOTH this and _stuck_build_rows' scan on every call, and they read
# the identical process table — passing the one snapshot down avoids paying
# for it twice. Falls back to scanning itself when called with no argument
# (every other caller, e.g. _do_reap, an occasional/human-confirmed op where
# a second `ps`/file-read is not worth complicating the call site over).
_orphan_rows() {
  local rows; if (( $# >= 1 )); then rows="$1"; else rows="$(_ps_snapshot_rows || true)"; fi
  [[ -z "$rows" ]] && return 0

  local check_owner=1
  [[ -n "${ORPHAN_PS_SRC:-}" ]] && check_owner=0
  local my_uid; my_uid="$(id -u)"

  local pid ppid etimes pcpu comm args
  while IFS=$'\t' read -r pid ppid etimes pcpu comm args; do
    [[ -z "$pid" ]] && continue
    [[ "$ppid" == "1" ]] || continue
    [[ "$etimes" =~ ^[0-9]+$ ]] || continue
    (( etimes > 300 )) || continue
    [[ "$comm" =~ $_ORPHAN_PROTECTED_PATTERN ]] && continue
    if ! [[ "$args" =~ $_ORPHAN_DEV_PATTERN ]] && [[ "$args" != *shell-snapshots* ]]; then
      continue
    fi
    if (( check_owner )); then
      local owner_uid
      if owner_uid="$(_proc_owner_uid "$pid")" && [[ -n "$owner_uid" ]]; then
        [[ "$owner_uid" != "$my_uid" ]] && continue
      else
        # Cannot establish ownership -> do NOT claim this process is ours.
        continue
      fi
    fi
    printf '%s\t%s\t%s\t%s\t%s\n' "$pid" "$etimes" "$pcpu" "$comm" "$args"
  done <<<"$rows"
}

# Shared with _orphan_activity's "suspect" classification (Step 4b): a
# subtree member can only be called suspect using the SAME age threshold this
# check names in its own "running >10m" text — never a second opinion on how
# old is "too old", or the two checks could contradict each other again on a
# process that is old enough for one but not the other.
_ORPHAN_SUSPECT_AGE_S=600

# One TSV row per process whose args match a *:build subcommand and has been
# running > _ORPHAN_SUSPECT_AGE_S — regardless of parentage. A plugin/package
# build takes seconds; one running 10+ minutes is worth a second look, whether
# or not its parent is still alive. Same TSV shape as _orphan_rows.
#
# Optional $1 = a pre-computed _ps_snapshot_rows result — see _orphan_rows'
# own comment for why _doctor_warnings passes the same snapshot to both.
_stuck_build_rows() {
  local rows; if (( $# >= 1 )); then rows="$1"; else rows="$(_ps_snapshot_rows || true)"; fi
  [[ -z "$rows" ]] && return 0

  local pid ppid etimes pcpu comm args
  while IFS=$'\t' read -r pid ppid etimes pcpu comm args; do
    [[ -z "$pid" ]] && continue
    [[ "$etimes" =~ ^[0-9]+$ ]] || continue
    (( etimes > _ORPHAN_SUSPECT_AGE_S )) || continue
    [[ "$args" == *:build* ]] || continue
    printf '%s\t%s\t%s\t%s\t%s\n' "$pid" "$etimes" "$pcpu" "$comm" "$args"
  done <<<"$rows"
}

# etimes (seconds) -> human age: "5h04m" or, under an hour, "12m".
_fmt_age_hm() {
  local secs="${1:-0}" h m
  h=$(( secs / 3600 ))
  m=$(( (secs % 3600) / 60 ))
  if (( h > 0 )); then printf '%dh%02dm' "$h" "$m"; else printf '%dm' "$m"; fi
}

# Friendly two-token label from a full args string, e.g. turns
# "node /path/node_modules/.bin/medusa plugin:build" into "medusa plugin:build":
# basename the last two whitespace-separated tokens (drop interpreter/path noise).
_short_cmd() {
  local args="$1"
  [[ -z "$args" ]] && { printf '(unknown)'; return; }
  # Claude shell-snapshot wrappers bury their real command behind a long
  # source+redirect line; name them for what they are instead.
  [[ "$args" == *shell-snapshots* ]] && { printf 'claude shell wrapper'; return; }
  # Identify a process by the HEAD of its command (interpreter, script,
  # subcommand), basenamed — not the tail, which is usually a redirect target
  # or a bare argument ("npm run dev" must not render as "run dev").
  local -a toks; read -ra toks <<<"$args"
  local out="" tok kept=0
  for tok in ${toks[@]+"${toks[@]}"}; do
    case "$tok" in '>'*|'<'*|'2>'*|'&'*'|'*|'|'*) break ;; esac
    [[ "$tok" == -* ]] && continue          # skip flags, keep subcommands
    out="${out:+$out }${tok##*/}"
    kept=$((kept+1)); (( kept >= 3 )) && break
  done
  printf '%s' "${out:-$args}"
}

# Command patterns that mark a process as legitimately long-running work whose
# loss would destroy something real: an agent run, a test suite, a build.
# Checked by _orphan_activity IN ADDITION to a raw CPU-busy threshold, because
# some real work reads near-0% CPU on any given sample (an agent waiting on a
# model response, `rsync` between bursts) yet is still work in progress.
#
# Split in two on purpose, both anchored/whole-token — NOT a bare substring
# search — after live testing on this box caught the obvious trap: an orphaned
# `claude` shell-snapshot wrapper always has "claude" somewhere in its own
# args (its snapshot path is literally .../.claude*/shell-snapshots/...), so
# an unanchored `=~ claude` would call EVERY claude-wrapper orphan "active"
# regardless of whether anything real is running underneath — defeating the
# whole point of this check for its single most common target. Single-word
# patterns are matched against a whole token (or `comm`) only; multi-word
# phrases are specific enough to substring-match safely.
_ORPHAN_ACTIVE_TOKEN_PATTERN='^(codex|claude|aider|pytest|ffmpeg|rsync|jest|vitest|tsc|webpack|cargo|gradle|mvn)$'
_ORPHAN_ACTIVE_PHRASE_PATTERN='docker build|npm test|npm run build'

# Sum of /proc/<pid>/io's syscr+syscw+wchar — a working build reads and
# writes constantly; a spin loop makes almost no syscalls, so this sum barely
# moves between two samples taken ~400ms apart. Prints nothing and fails
# (rather than printing "0") when the file is missing/unreadable, so a caller
# can tell "confirmed zero" apart from "could not read" — the same tri-state
# discipline this file's _rss_get (lib/json.sh) already documents for RSS.
_oa_io_counter() {
  local f="/proc/${1:-}/io"
  [[ -r "$f" ]] || return 1
  awk '/^(syscr|syscw|wchar):/ { a += $2 } END { print a+0 }' "$f" 2>/dev/null
}

# $1 = pid. Prints exactly one of: progress | no-progress | skip.
#
# Linux-only: /proc does not exist on macOS, so on any non-Linux host this
# is ALWAYS skip — the verdict must stay exactly what it is today, never
# silently degrade into "no progress detected" just because the probe itself
# isn't available there.
#
# A fictional $ORPHAN_PS_SRC fixture pid must never drive a REAL /proc read
# either: its pid is an arbitrary test number that can coincidentally collide
# with an unrelated real pid on whatever host runs the suite (the exact
# hazard _do_reap's own dry-run guard documents for kill() — just as real
# for a read, since a coincidental hit could flake a test's verdict). That
# case is also skip, unless the test opts in below.
#
# skip (for any reason) leaves the caller's verdict at "active", never
# "suspect" — the conservative asymmetry this file's _orphan_activity header
# documents: a false active only delays a reap, but a *confirmed* no-progress
# reading is what lets --force touch the process, so it must never be
# answered with a guess.
#
# $ORPHAN_IO_SRC (pid<TAB>sample1<TAB>sample2, one line per pid) replaces the
# probe end-to-end for tests: deterministic, and it removes the real ~400ms
# sleep from the test path entirely.
_oa_io_progress() {
  local pid="$1"
  if [[ -n "${ORPHAN_IO_SRC:-}" ]]; then
    local line s1 s2
    line="$(awk -F'\t' -v p="$pid" '$1==p{print; exit}' "$ORPHAN_IO_SRC" 2>/dev/null || true)"
    [[ -z "$line" ]] && { printf 'skip'; return 0; }
    IFS=$'\t' read -r _ s1 s2 <<<"$line"
    [[ "$s1" =~ ^[0-9]+$ && "$s2" =~ ^[0-9]+$ ]] || { printf 'skip'; return 0; }
    if (( s2 > s1 )); then printf 'progress'; else printf 'no-progress'; fi
    return 0
  fi
  [[ -n "${ORPHAN_PS_SRC:-}" ]] && { printf 'skip'; return 0; }
  [[ "$(_compat_os)" == "linux" ]] || { printf 'skip'; return 0; }
  local s1 s2
  s1="$(_oa_io_counter "$pid")" || { printf 'skip'; return 0; }
  sleep 0.4
  s2="$(_oa_io_counter "$pid")" || { printf 'skip'; return 0; }
  if (( s2 > s1 )); then printf 'progress'; else printf 'no-progress'; fi
}

# Classify an orphan's full descendant subtree (the orphan pid itself, plus
# every process reparented under it) as "idle", "active", or "suspect".
# Prints "<state><TAB><reason><TAB><subtree>" on stdout, where <subtree> is
# every pid\x1fcmd\x1fpcpu record examined, joined by \x1e — a caller can
# always show what was looked at, whatever the verdict.
#
# WHY this exists: `doctor` flags a pid as an orphan by looking only at ITS
# OWN ppid/CPU — but the orphan is frequently just a shell wrapper sitting at
# 0.0% CPU with a real, busy job running several levels down (e.g. a `claude`
# shell wrapper -> `bash run.sh` -> `codex exec`, actively writing logs).
# `--reap` kills the whole subtree (_pid_descendants), so judging only the
# root pid would silently destroy that job. This walks the whole subtree
# instead.
#
# Reads the SAME process source as everything else (_ps_snapshot_rows), so it
# honors $ORPHAN_PS_SRC in tests and never reads /proc directly itself for
# the subtree walk (only _oa_io_progress ever touches /proc, and only for a
# CPU-busy, already-old candidate — see that function's own header).
#
# Deliberately conservative, on purpose: a false "active"/"suspect" only
# costs a skipped reap (the process spins a little longer — harmless); a
# false "idle" destroys real work. When genuinely in doubt, this calls it
# active.
#
# 2026-08-03 finding (task-5-brief.md Step 4b): a spinning `*:build` process
# read ~33% CPU with almost no real I/O over a 3s sample — CPU alone cannot
# tell "spinning" apart from "building", so a subtree member this busy AND
# old enough to already be flagged "hung" elsewhere (_stuck_build_rows'
# _ORPHAN_SUSPECT_AGE_S) AND confirmed making no I/O progress is "suspect",
# never silently "idle" and never silently upgraded to a stronger claim than
# the evidence supports — the wording says "appears hung", not "is hung",
# because a genuine CPU-bound phase (type-checking, say) can be quiet too.
# Any OTHER subtree member that reads clearly active (busy-and-young,
# busy-and-progressing, or matches the token/phrase patterns below) keeps the
# WHOLE subtree "active" regardless of what else is also spinning next to
# it — reaping it would still destroy that other member's real work.
_orphan_activity() {
  local root="$1"
  # $2 (optional): a pre-computed _ps_snapshot_rows table. The Processes place
  # polls this, and re-snapshotting per orphan is what made `doctor` cost 2.4s
  # — the same per-row-fork shape fixed twice already elsewhere in this file.
  # The argument is optional so every existing caller keeps working unchanged.
  local rows="${2:-}"
  [[ -n "$rows" ]] || rows="$(_ps_snapshot_rows || true)"
  [[ -z "$rows" ]] && { printf 'idle\t\t'; return 0; }

  local -A _oa_children _oa_pcpu _oa_args _oa_comm _oa_etimes
  local pid ppid etimes pcpu comm args
  while IFS=$'\t' read -r pid ppid etimes pcpu comm args; do
    [[ -z "$pid" ]] && continue
    _oa_children[$ppid]+=" $pid"
    _oa_pcpu[$pid]="$pcpu"
    _oa_args[$pid]="$args"
    _oa_comm[$pid]="$comm"
    _oa_etimes[$pid]="$etimes"
  done <<<"$rows"

  local -a queue=("$root") subtree=()
  local qi=0
  while (( qi < ${#queue[@]} )); do
    local cur="${queue[$qi]}"; qi=$((qi+1))
    subtree+=("$cur")
    local k
    for k in ${_oa_children[$cur]:-}; do queue+=("$k"); done
  done

  # Every return path below carries this SAME subtree — including idle — so
  # a caller can always show exactly what was examined to reach the verdict.
  local sub="" p
  for p in "${subtree[@]}"; do
    [[ -n "$sub" ]] && sub+=$'\x1e'
    sub+="$p"$'\x1f'"$(_short_cmd "${_oa_args[$p]:-}")"$'\x1f'"${_oa_pcpu[$p]:-0}"
  done

  local active_reason="" suspect_reason=""
  for p in "${subtree[@]}"; do
    local pc="${_oa_pcpu[$p]:-0}"
    awk -v v="$pc" 'BEGIN{ if (v+0>=0.5) exit 0; exit 1 }' 2>/dev/null || continue
    local age="${_oa_etimes[$p]:-0}" is_suspect=0
    if [[ "$age" =~ ^[0-9]+$ ]] && (( age > _ORPHAN_SUSPECT_AGE_S )); then
      [[ "$(_oa_io_progress "$p")" == "no-progress" ]] && is_suspect=1
    fi
    if (( is_suspect )); then
      [[ -z "$suspect_reason" ]] && suspect_reason="$(_short_cmd "${_oa_args[$p]:-}") (${pc}% CPU, $(_fmt_age_hm "$age"), no I/O progress) — appears hung, not confirmed"
    else
      active_reason="$(_short_cmd "${_oa_args[$p]:-}") (${pc}% CPU)"
      break
    fi
  done
  if [[ -n "$active_reason" ]]; then
    printf 'active\t%s\t%s' "$active_reason" "$sub"
    return 0
  fi
  if [[ -n "$suspect_reason" ]]; then
    printf 'suspect\t%s\t%s' "$suspect_reason" "$sub"
    return 0
  fi

  for p in "${subtree[@]}"; do
    local ar="${_oa_args[$p]:-}" cm="${_oa_comm[$p]:-}"
    if [[ "$cm" =~ $_ORPHAN_ACTIVE_TOKEN_PATTERN ]] || [[ "$ar" =~ $_ORPHAN_ACTIVE_PHRASE_PATTERN ]]; then
      printf 'active\t%s\t%s' "$(_short_cmd "$ar") (long-running job)" "$sub"
      return 0
    fi
    local -a _oa_toks; read -ra _oa_toks <<<"$ar"
    local t tb
    for t in ${_oa_toks[@]+"${_oa_toks[@]}"}; do
      tb="${t##*/}"
      if [[ "$tb" =~ $_ORPHAN_ACTIVE_TOKEN_PATTERN ]]; then
        printf 'active\t%s\t%s' "$(_short_cmd "$ar") (long-running job)" "$sub"
        return 0
      fi
    done
  done
  printf 'idle\t\t%s' "$sub"
}

# ---- doctor checks ---------------------------------------------------------
# Return value: array of warning lines, plus an exit-code summary.
# Stdout = warnings (one per line, possibly colored); returns count via $?
#
# Optional $1 = pre-computed _session_rows output, for callers that already
# scanned (cmd_ls, cmd_doctor) — skips a second full session-file scan. Falls
# back to scanning itself when called with no argument, so this stays a safe
# standalone call for anything else. Passing the STRING (not re-deriving it)
# is what actually avoids the rescan: _session_rows always runs inside a
# `$(...)` subshell, so any cache built *inside* it is discarded the instant
# that subshell exits — only hoisting the one real scan into the caller's own
# shell and handing the result down here works.
#
# _DOCTOR_ISSUES: the SAME data, structured, for lib/json.sh's issues/processes
# sections. One implementation, two renderings — every check below both PRINTS
# its existing human line (unchanged, byte-for-byte) AND appends a
# kind<TAB>severity<TAB>pid<TAB>sid<TAB>text row here. A bash array element can
# hold an embedded tab safely (there is no IFS splitting until something reads
# it back with `read`/`split` on purpose), so this is not the "tab is IFS
# whitespace" hazard — that hazard is about a per-row `read`, not about storing
# a pre-joined string in an array slot. Reset at the top of every call: this
# function can run more than once per process (ls, then doctor), and a stale
# row from an earlier call must never leak into a later section.
declare -a _DOCTOR_ISSUES=()
_di_add() {
  # kind severity pid sid text — '-' for pid/sid when not applicable, matching
  # this codebase's existing TSV-placeholder convention (_SESSION_JQ's `def d`).
  _DOCTOR_ISSUES+=("$1"$'\t'"$2"$'\t'"${3:--}"$'\t'"${4:--}"$'\t'"$5")
}
_doctor_warnings() {
  _DOCTOR_ISSUES=()
  local rows
  if (( $# >= 1 )); then rows="$1"; else rows="$(_session_rows || true)"; fi
  # Optional $2 = a pre-computed _ps_snapshot_rows table, for callers
  # (lib/json.sh's _json_envelope) that ALSO need the identical table for
  # their own processes section — sharing it is what keeps the issues and
  # processes item counts unable to disagree "by construction" (cmd_doctor's
  # own comment on _DOCTOR_ISSUES): two renderings of one real snapshot,
  # never two independent `ps` reads a live process could exit between.
  # Falls back to scanning itself when called with no such argument (every
  # other caller, e.g. the human `doctor` path), so this stays a safe
  # standalone call.
  local ps_rows="${2:-}"

  # Checks (1)-(5) inspect Claude session-state JSON files, so they need at
  # least one live/known session to say anything. Checks (6)-(7) scan the OS
  # process table directly and must run even with zero Claude sessions —
  # that's exactly the state a box is in after the incident this guards
  # against: every claude/tmux parent is long gone, only orphaned children
  # (and possibly hung builds) remain.
  if [[ -n "$rows" ]]; then

  # ONE bash-native pass over $rows building every grouping checks (1)-(5)
  # need, instead of 6 separate `awk` forks (one per check's own grouping/
  # projection, plus a second pipeline stage for check 3) — bash's own `read`
  # already splits the tab-delimited columns _session_rows emits, and
  # `map[key]+=...`-style accumulation needs no subprocess at all. Same
  # "hoist one scan, pass it down" principle already applied to
  # _ps_snapshot_rows/_ram_load/_ot_load elsewhere in this codebase: checks
  # (1)-(5) were the one place left still paying an unconditional per-check
  # fork for a scan the other checks already share. Measured: these 6 awk
  # forks alone cost ~90-120ms of the ~400ms poll budget in this sandbox
  # (see tests/test_scan_fork_budget.sh's own fork-cost note) — pure
  # overhead, since none of it varies with row count in the fixtures that
  # exercise it.
  local -A _dw_sid_pids=() _dw_sid_n=() _dw_bid_pids=() _dw_bid_n=() \
           _dw_ca_pids=() _dw_ca_n=() _dw_ca_bridged=()
  local -a _dw_waiting=() _dw_stale=()
  local dw_sess dw_pid dw_cwd dw_entry dw_status dw_sid dw_bid dw_upd dw_alive dw_acct dw_key dw_mark
  while IFS=$'\t' read -r dw_sess dw_pid dw_cwd dw_entry dw_status dw_sid dw_bid dw_upd dw_alive dw_acct; do
    [[ -z "$dw_pid" ]] && continue
    dw_mark=""
    [[ "$dw_bid" != "-" && -n "$dw_bid" ]] && dw_mark="|OK"
    if [[ "$dw_sid" != "-" && -n "$dw_sid" ]]; then
      _dw_sid_pids[$dw_sid]="${_dw_sid_pids[$dw_sid]:+${_dw_sid_pids[$dw_sid]}:}$dw_pid"
      _dw_sid_n[$dw_sid]=$(( ${_dw_sid_n[$dw_sid]:-0} + 1 ))
    fi
    if [[ "$dw_bid" != "-" && -n "$dw_bid" ]]; then
      _dw_bid_pids[$dw_bid]="${_dw_bid_pids[$dw_bid]:+${_dw_bid_pids[$dw_bid]}:}$dw_pid"
      _dw_bid_n[$dw_bid]=$(( ${_dw_bid_n[$dw_bid]:-0} + 1 ))
    fi
    dw_key="$dw_cwd#$dw_acct"
    _dw_ca_pids[$dw_key]="${_dw_ca_pids[$dw_key]:+${_dw_ca_pids[$dw_key]}:}${dw_pid}${dw_mark}"
    _dw_ca_n[$dw_key]=$(( ${_dw_ca_n[$dw_key]:-0} + 1 ))
    [[ -n "$dw_mark" ]] && _dw_ca_bridged[$dw_key]=$(( ${_dw_ca_bridged[$dw_key]:-0} + 1 ))
    if [[ "$dw_alive" == "1" && "$dw_status" == waiting* ]]; then
      _dw_waiting+=("$dw_pid"$'\t'"$dw_cwd"$'\t'"$dw_status"$'\t'"$dw_upd")
    fi
    [[ "$dw_alive" == "0" ]] && _dw_stale+=("$dw_pid"$'\t'"$dw_cwd"$'\t'"$dw_acct")
  done <<<"$rows"

  # (1) Two PIDs with the SAME sessionId  — true "exact same chat opened twice".
  local sid
  for sid in "${!_dw_sid_pids[@]}"; do
    local count="${_dw_sid_n[$sid]}" pids="${_dw_sid_pids[$sid]}"
    if (( count > 1 )); then
      printf '%b same chat %s open in %d procs: %s\n' \
        "$GLYPH_ALERT" "$(truncate_str "$sid" 18)" "$count" "$(truncate_str "$pids" 40)"
      _di_add "same-chat-twice" "warning" "" "$sid" \
        "same chat open in $count procs: $pids"
    fi
  done

  # (2) Two PIDs with the SAME bridgeSessionId — Remote Control bridge held by two procs.
  local bid
  for bid in "${!_dw_bid_pids[@]}"; do
    local count="${_dw_bid_n[$bid]}" pids="${_dw_bid_pids[$bid]}"
    if (( count > 1 )); then
      printf '%b RC bridge %s held by %d procs: %s\n' \
        "$GLYPH_ALERT" "$(truncate_str "$bid" 18)" "$count" "$(truncate_str "$pids" 40)"
      _di_add "rc-bridge-shared" "warning" "" "" \
        "RC bridge $bid held by $count procs: $pids"
    fi
  done

  # (3) Multiple PIDs for same (cwd, account) but only some bridged — duplicate-RC
  # pattern. Different accounts sharing a cwd are excluded on purpose (see the
  # per-(cwd,account) dup-guard in the launch path).
  local key
  for key in "${!_dw_ca_pids[@]}"; do
    local dup_cwd="${key%%#*}" dup_acct="${key#*#}"
    local total="${_dw_ca_n[$key]}" bridged="${_dw_ca_bridged[$key]:-0}" group="${_dw_ca_pids[$key]}"
    if (( total > 1 && bridged >= 1 && bridged < total )); then
      local acct_tag=""
      [[ "$dup_acct" != "default" ]] && acct_tag=" [$dup_acct]"
      printf '%b %s%s: %d procs, %d bridged — others mirror text, no approvals\n' \
        "$GLYPH_ALERT" "$(short_home "$dup_cwd")" "$acct_tag" "$total" "$bridged"
      printf '    PIDs: %s\n' "$(truncate_str "$group" 60)"
      _di_add "duplicate-bridge" "warning" "" "" \
        "$dup_cwd$acct_tag: $total procs, $bridged bridged — others mirror text, no approvals ($group)"
    fi
  done

  # (4) "Waiting" stalled > 5 minutes — phone approval was likely lost. `now`
  # is fetched once (if anything is even waiting), never once per matched row.
  if (( ${#_dw_waiting[@]} > 0 )); then
    local now; now="$(date +%s)"
    local w wpid wcwd wstatus wupd
    for w in "${_dw_waiting[@]}"; do
      IFS=$'\t' read -r wpid wcwd wstatus wupd <<<"$w"
      local secs=$(( wupd / 1000 ))
      local age=$(( now - secs ))
      if (( age >= 300 )); then
        printf '%b pid %s (%s) stuck "%s" %s — phone approval lost\n' \
          "$GLYPH_ALERT" "$wpid" "$(short_home "$wcwd")" "$(truncate_str "$wstatus" 18)" "$(ms_relative "$wupd")"
        _di_add "stalled" "warning" "$wpid" "" \
          "pid $wpid ($wcwd) stuck \"$wstatus\" — phone approval lost"
      fi
    done
  fi

  # (5) Stale session files (PID gone).
  local s
  for s in "${_dw_stale[@]}"; do
    local spid scwd sacct
    IFS=$'\t' read -r spid scwd sacct <<<"$s"
    local stale_sdir; stale_sdir="$(_account_dir_or_default "$sacct")/sessions"
    printf '%b stale: %s/%s.json (pid gone, %s)\n' \
      "$GLYPH_DASH" "$(short_home "$stale_sdir")" "$spid" "$(short_home "$scwd")"
    _di_add "stale" "info" "$spid" "" \
      "stale: $stale_sdir/$spid.json (pid gone, $scwd)"
  done

  fi # [[ -n "$rows" ]]

  # (6) Orphaned dev processes (ppid=1) — parents died, children were
  # reparented to init and spin forever (the exact failure mode that
  # CPU-limited this box: 8 orphaned `medusa plugin:build` + 6 abandoned
  # `npm run dev` trees, invisible to checks (1)-(5)).
  #
  # An orphan itself can read 0.0% CPU while a descendant several levels down
  # is doing real work (a `claude` shell wrapper -> `bash run.sh` -> `codex
  # exec`, actively writing logs) — reap kills the whole subtree, so each
  # orphan is classified via _orphan_activity BEFORE anything is shown, and
  # the summary + per-line markers reflect what --reap would actually be safe
  # to touch.
  #
  # ONE process-table snapshot for both check (6) and check (7) below — they
  # read the identical table, and this call used to happen twice (once
  # inside each of _orphan_rows/_stuck_build_rows), doubling `ps`'s cost on
  # every `ls`/`doctor` for no reason. Uses the pre-computed $ps_rows (this
  # function's own optional $2) when a caller already has one, so lib/json.sh
  # never pays for a second real snapshot to build its processes section from
  # the same data this function's own _di_add calls just described.
  [[ -n "$ps_rows" ]] || ps_rows="$(_ps_snapshot_rows || true)"
  local orphan_rows; orphan_rows="$(_orphan_rows "$ps_rows" || true)"
  if [[ -n "$orphan_rows" ]]; then
    local orphan_count total_cpu
    orphan_count="$(wc -l <<<"$orphan_rows")"
    total_cpu="$(awk -F'\t' '{sum+=$3} END{printf "%.1f", sum+0}' <<<"$orphan_rows")"

    local reapable_count=0 busy_count=0
    local -A _oa_status _oa_reason
    local pid etimes pcpu comm args act state reason subtree
    while IFS=$'\t' read -r pid etimes pcpu comm args; do
      [[ -z "$pid" ]] && continue
      act="$(_orphan_activity "$pid" "$ps_rows")"
      IFS=$'\t' read -r state reason subtree <<<"$act"
      _oa_status[$pid]="$state"
      _oa_reason[$pid]="$reason"
      case "$state" in
        active)
          busy_count=$((busy_count+1))
          _di_add "orphan-process" "info" "$pid" "" \
            "orphaned dev process $pid ($(_short_cmd "$args")), $(_fmt_age_hm "$etimes") — active (${reason}), reap will skip it"
          ;;
        suspect)
          busy_count=$((busy_count+1))
          _di_add "orphan-process" "warning" "$pid" "" \
            "orphaned dev process $pid ($(_short_cmd "$args")), $(_fmt_age_hm "$etimes") — ${reason}; reap will skip it, doctor --reap --force overrides"
          ;;
        *)
          reapable_count=$((reapable_count+1))
          _di_add "orphan-process" "warning" "$pid" "" \
            "orphaned dev process $pid ($(_short_cmd "$args")), $(_fmt_age_hm "$etimes") — reapable"
          ;;
      esac
    done <<<"$orphan_rows"

    printf '%b %d orphaned dev process(es) (ppid=1), %s%% CPU total — %d reapable, %d busy (parents died)\n' \
      "$GLYPH_ALERT" "$orphan_count" "$total_cpu" "$reapable_count" "$busy_count"
    local shown=0
    while IFS=$'\t' read -r pid etimes pcpu comm args; do
      (( shown >= 5 )) && continue
      shown=$((shown+1))
      local marker=""
      [[ "${_oa_status[$pid]:-idle}" == "idle" ]] && marker="  [reapable]"
      printf '    pid %s  %s  %s%%  %s%s\n' \
        "$pid" "$(_fmt_age_hm "$etimes")" "$pcpu" "$(truncate_str "$(_short_cmd "$args")" 50)" "$marker"
      case "${_oa_status[$pid]:-idle}" in
        active)  printf '        ↳ active: %s — reap will skip it\n' "${_oa_reason[$pid]}" ;;
        suspect) printf '        ↳ suspect: %s — reap skips it by default, --reap --force overrides\n' "${_oa_reason[$pid]}" ;;
      esac
    done <<<"$orphan_rows"
    if (( orphan_count > 5 )); then
      printf '    … and %d more\n' "$(( orphan_count - 5 ))"
    fi
    printf '    → reap them: claude-session doctor --reap\n'
  fi

  # (7) Stuck builds (*:build), regardless of parentage — a plugin/package
  # build takes seconds; one running past _ORPHAN_SUSPECT_AGE_S is worth a
  # second look. Each pid is ALSO run through _orphan_activity (rooted at
  # itself, over the SAME $ps_rows check (6) shares) so this check's own
  # per-process text can never again contradict check (6)'s for the same
  # pid — the exact defect task-5-brief.md Step 4b measured on 2026-08-03,
  # where this line unconditionally said "hung" for a pid check (6) had
  # already called "active" from the same CPU sample. The one-line summary
  # below still names why the check exists (a build running this long is
  # always worth a look); the per-process resolution says whether it is
  # actually still working, only suspected of being stuck, or genuinely idle.
  local stuck_rows; stuck_rows="$(_stuck_build_rows "$ps_rows" || true)"
  if [[ -n "$stuck_rows" ]]; then
    local stuck_count oldest
    stuck_count="$(wc -l <<<"$stuck_rows")"
    oldest="$(awk -F'\t' 'BEGIN{m=0} {if($2+0>m) m=$2+0} END{print m}' <<<"$stuck_rows")"
    printf '%b %d stuck build process(es) — *:build running >10m (oldest %s) — running this long CAN mean hung, but CPU alone cannot tell spinning from building; see doctor --reap for the per-process call\n' \
      "$GLYPH_ALERT" "$stuck_count" "$(_fmt_age_hm "$oldest")"
    local sb_pid sb_etimes sb_pcpu sb_comm sb_args sb_act sb_state sb_reason sb_sub sb_note
    while IFS=$'\t' read -r sb_pid sb_etimes sb_pcpu sb_comm sb_args; do
      [[ -z "$sb_pid" ]] && continue
      sb_act="$(_orphan_activity "$sb_pid" "$ps_rows")"
      IFS=$'\t' read -r sb_state sb_reason sb_sub <<<"$sb_act"
      case "$sb_state" in
        active)  sb_note="still active (${sb_reason}) — a build this long is not hung here, reap would skip it" ;;
        suspect) sb_note="${sb_reason} — reap skips it by default, doctor --reap --force overrides" ;;
        *)       sb_note="no CPU/IO activity — a build this long is hung" ;;
      esac
      _di_add "stuck-build" "warning" "$sb_pid" "" \
        "stuck build $sb_pid ($(_short_cmd "$sb_args")), running $(_fmt_age_hm "$sb_etimes") — $sb_note"
    done <<<"$stuck_rows"
  fi

  # (8) Title index health. A degraded cache never announces itself any other
  # way — a query beside it just falls back to a slower read — so `doctor` is
  # where a user learns to run the rebuild. Called directly (not via `$(...)`),
  # unlike checks (1)-(7)'s row-producing helpers: this one calls _di_add
  # itself, and a command-substitution subshell would discard that mutation
  # to _DOCTOR_ISSUES the instant it exits (the same hazard _session_rows'
  # own comment documents for owner_tmux's cache) — printf still reaches this
  # function's own stdout exactly as before, just without the extra fork.
  _doctor_title_index

  # (9) Upstream session-state schema drift (see _doctor_upstream_fields).
  # Now feeds _DOCTOR_ISSUES too (one entry per unknown field, same rule as
  # check 8): both used to be excluded with the reasoning "cache/schema
  # health, not a per-session or per-process issue" — but that made the
  # inventory an undercount, and a monitor trusting the exit status would
  # never learn its title index degraded or its upstream schema drifted.
  # Same direct-call reasoning as check (8) above.
  _doctor_upstream_fields

  # _DOCTOR_ISSUES is now the ONE inventory every check (1)-(9) feeds — the
  # human "N issue(s) flagged" line (cmd_doctor), the plain-doctor exit
  # status (cmd_doctor), the `ls` warning count, and the JSON issues+processes
  # item counts (lib/json.sh) all derive from this SAME array, so they cannot
  # disagree by construction. Returned via $? (not printed): every caller
  # that wants the count already invokes this function through `$(...)` to
  # capture its human text, which forks a subshell — the array itself dies
  # with that subshell, but a plain integer exit status crosses it for free.
  # Clamped to 250: an exit status is one byte (0-255), so an unclamped count
  # above that would wrap — 256 real issues silently reported as "0, all
  # clear" would be the exact silent-success lie this whole mechanism exists
  # to prevent, just relocated to a different threshold.
  local total="${#_DOCTOR_ISSUES[@]}"
  (( total > 250 )) && total=250
  return "$total"
}

# Upstream session-state schema drift, check (9). ONE batched jq call across
# every account's sessions/*.json (never one per file — that would refork jq
# once per session file, exactly the anti-pattern _session_rows was fixed
# for), diffed against the known field set. Reports each unseen key once.
#
# Deliberately ONE-DIRECTIONAL: the brief's counterpart — report a KNOWN field
# missing from N file(s) — is NOT implemented. More than half of the known set
# (waitingFor, and two of the three timestamp aliases statusUpdatedAt/
# updatedAt/startedAt) are legitimately, routinely absent from a healthy file
# by this very codebase's own understanding of the schema (_SESSION_JQ's `def
# d` comment documents exactly this: a missing waitingFor and a "" bridge are
# both normal, not defects). Implementing "missing known field = issue"
# literally would flag almost every session file in existence — including
# every fixture already in this suite (fake_session never sets any of those
# three) — turning "all clear" into a permanent false positive across
# test_ls_doctor_multiaccount.sh and test_doctor_orphans.sh. Only the
# unknown-field direction (real, unambiguous schema growth) is implemented.
_DOCTOR_KNOWN_SESSION_FIELDS="pid cwd entrypoint status waitingFor sessionId bridgeSessionId statusUpdatedAt updatedAt startedAt"
# Fields the tool does NOT parse but has SEEN and deemed benign — real upstream
# schema growth that carries nothing the tool needs, so flagging it on every
# `doctor` run is noise, not signal. It also inflates doctor's issue count and
# its exit status (which a monitoring loop keys on), so an unacknowledged-forever
# warning is worse than useless. Same discipline as CI's macOS skip allowlist: a
# field lands here only once a human has confirmed the tool losing it changes
# nothing. A field in NEITHER list still flags — genuine drift the tool may be
# silently missing data from is exactly what the check exists to surface.
#
# These accompany current Claude Code / launcher session state (naming, a format
# version, process-start and peer/job bookkeeping). Per-host additions extend
# this without editing the file, via CS_DOCTOR_BENIGN_FIELDS (space-separated).
_DOCTOR_BENIGN_SESSION_FIELDS="version procStart kind name nameSource peerProtocol jobId parkedJobId"
_doctor_upstream_fields() {
  shopt -s nullglob
  local -a files=()
  local acct dir f
  while IFS=$'\t' read -r acct dir; do
    for f in "$dir/sessions"/*.json; do
      [[ -f "$f" ]] && files+=("$f")
    done
  done < <(_all_accounts)
  # `jq` with no file arguments reads stdin and hangs — never let an empty
  # glob (no accounts, or none with a sessions dir yet) reach it.
  (( ${#files[@]} )) || return 0
  local keys
  keys="$(jq -rs '[.[] | keys[]] | unique | .[]' "${files[@]}" 2>/dev/null || true)"
  [[ -n "$keys" ]] || return 0
  local k
  while IFS= read -r k; do
    [[ -z "$k" ]] && continue
    case " $_DOCTOR_KNOWN_SESSION_FIELDS $_DOCTOR_BENIGN_SESSION_FIELDS ${CS_DOCTOR_BENIGN_FIELDS:-} " in
      *" $k "*) continue ;;
    esac
    printf "%b unknown session-state field '%s' (upstream schema changed — claude-session may be missing data)\n" \
      "$GLYPH_ALERT" "$k"
    _di_add "upstream-field" "warning" "" "" \
      "unknown session-state field '$k' (upstream schema changed — claude-session may be missing data)"
  done <<<"$keys"
  return 0
}

# Title index check (8) for _doctor_warnings above. Runs unconditionally — the
# index's health has nothing to do with whether any Claude session is currently
# alive. Each detected problem TYPE (unreadable lines, duplicate lines, a stale
# majority) is its own line and counts as one issue, same as every other check
# here.
_doctor_title_index() {
  _ti_load
  # Present but unreadable/cold: the file EXISTS (so this isn't just "never
  # built yet" — a brand-new install with no index at all is normal, not an
  # issue) yet _ti_load bailed to cold — a 0-byte file (crash mid-write, disk
  # full, a manual `: >` truncation) or an unrecognized version header, either
  # way an index that cannot serve a single hit and was silently reporting
  # nothing before this check existed. `_ti_put` heals it on the next write;
  # this is what tells a user that write hasn't happened yet.
  if [[ "$TI_STATE" == "cold" && -e "$TITLE_INDEX" ]]; then
    printf '%b title index: present but unreadable/cold (missing or unrecognized version header) — run claude-session _titles --rebuild\n' \
      "$GLYPH_ALERT"
    _di_add "title-index" "warning" "" "" \
      "title index: present but unreadable/cold (missing or unrecognized version header) — run claude-session _titles --rebuild"
  fi
  if (( TI_SKIPPED > 0 )); then
    printf '%b title index: %d unreadable line(s) — run claude-session _titles --rebuild\n' \
      "$GLYPH_ALERT" "$TI_SKIPPED"
    _di_add "title-index" "warning" "" "" \
      "title index: $TI_SKIPPED unreadable line(s) — run claude-session _titles --rebuild"
  fi
  if (( TI_DUPES > 0 )); then
    printf '%b title index: %d duplicate line(s) — run claude-session _titles --rebuild\n' \
      "$GLYPH_ALERT" "$TI_DUPES"
    _di_add "title-index" "warning" "" "" \
      "title index: $TI_DUPES duplicate line(s) — run claude-session _titles --rebuild"
  fi
  # Append-only growth means every mtime/size change adds a line and nothing
  # ever compacts one away — TI_STALE lines are the dead weight from that.
  # _ti_load already sets TI_STATE=stale once it clears both the hysteresis
  # multiple AND the absolute floor (see the threshold comment in
  # lib/titleindex.sh's _ti_load) — never on a bare majority, so this stays
  # an actionable signal instead of firing on ordinary day-to-day use.
  if [[ "$TI_STATE" == "stale" ]]; then
    printf '%b title index: stale — %d superseded line(s), more than 3x the %d live — run claude-session _titles --rebuild\n' \
      "$GLYPH_ALERT" "$TI_STALE" "$((TI_ENTRIES - TI_STALE))"
    _di_add "title-index" "warning" "" "" \
      "title index: stale — $TI_STALE superseded line(s), more than 3x the $((TI_ENTRIES - TI_STALE)) live — run claude-session _titles --rebuild"
  fi
  return 0
}

# Per-pid: does it have any warning? Lightweight check used by `ls` to mark cards.
declare -A PID_FLAG_TEXT

# Optional $1 = pre-computed _session_rows output (see _doctor_warnings above
# for why passing the string down, not re-deriving it, is what actually skips
# the rescan). Falls back to scanning itself when called with no argument.
_compute_pid_flags() {
  local rows
  if (( $# >= 1 )); then rows="$1"; else rows="$(_session_rows || true)"; fi
  [[ -z "$rows" ]] && return

  # (cwd, account) dup-only-some-bridged → flag all non-bridged PIDs in that
  # group as "duplicate". Different accounts in the same cwd are independent
  # RC bridges, not a conflict, so the grouping key includes account (field 10).
  declare -A CWD_TOTAL CWD_BRIDGED
  while IFS=$'\t' read -r pid key bid; do
    CWD_TOTAL[$key]=$(( ${CWD_TOTAL[$key]:-0} + 1 ))
    [[ "$bid" != "-" && -n "$bid" ]] && CWD_BRIDGED[$key]=$(( ${CWD_BRIDGED[$key]:-0} + 1 ))
  done < <(awk -F '\t' '$9=="1" {print $2"\t"$3"#"$10"\t"$7}' <<<"$rows")

  while IFS=$'\t' read -r pid key bid sid status updated_ms alive; do
    [[ "$alive" != "1" ]] && { PID_FLAG_TEXT[$pid]="${R}stale${N}"; continue; }
    local f=""
    local total="${CWD_TOTAL[$key]:-0}" bridged="${CWD_BRIDGED[$key]:-0}"
    if (( total > 1 && bridged >= 1 && bridged < total )) && [[ "$bid" == "-" || -z "$bid" ]]; then
      f="${Y}duplicate${N}"
    fi
    if [[ "$status" == waiting* ]]; then
      local secs
      local age
      secs=$(( updated_ms / 1000 ))
      age=$(( $(date +%s) - secs ))
      if (( age >= 300 )); then
        [[ -n "$f" ]] && f+=" "
        f+="${Y}stalled${N}"
      fi
    fi
    PID_FLAG_TEXT[$pid]="$f"
  done < <(awk -F '\t' '{print $2"\t"$3"#"$10"\t"$7"\t"$6"\t"$5"\t"$8"\t"$9}' <<<"$rows")
}

# ---- ls --------------------------------------------------------------------
# Index -> session maps, populated by cmd_ls and consumed by the picker.
declare -a IDX_SESS IDX_PID IDX_CWD IDX_SID IDX_ACCOUNT
LS_COUNT=0   # number of cards rendered by the last cmd_ls (consumed by resume)

cmd_ls() {
  if (( JSON_OUT == 1 )); then _json_envelope "chats,issues"; return $?; fi
  LS_COUNT=0
  local rows; rows="$(_session_rows || true)"
  if [[ -z "$rows" ]]; then
    box_top "Claude sessions"
    box_line "$(printf '%bno active Claude processes%b' "$DIM" "$N")"
    # Show tmux sessions whose Claude has exited
    local stale
    stale="$(tmux ls 2>/dev/null | grep -E -- '-claude' || true)"
    if [[ -n "$stale" ]]; then
      box_blank
      box_line "$(printf '%btmux sessions where claude exited:%b' "$DIM" "$N")"
      while IFS= read -r line; do box_line "  $line"; done <<<"$stale"
    fi
    box_bottom
    return
  fi

  _compute_pid_flags "$rows"
  _ledger_provenance_load
  _ram_load

  box_top "Claude sessions"
  local first=1 i=0
  while IFS=$'\t' read -r sess pid cwd entry status sid bid updated_ms alive account; do
    if (( !first )); then box_blank; fi
    first=0
    i=$((i+1))
    IDX_SESS[$i]="$sess"; IDX_PID[$i]="$pid"; IDX_CWD[$i]="$cwd"; IDX_SID[$i]="$sid"; IDX_ACCOUNT[$i]="$account"

    local glyph="$GLYPH_OK"
    [[ "$alive" != "1" ]] && glyph="$GLYPH_FAIL"
    local flag="${PID_FLAG_TEXT[$pid]:-}"
    [[ -n "$flag" ]] && glyph="$GLYPH_WARN"

    # line 1: [N] glyph SESSION  pid PID  RAM  CWD  [account]
    local proj; proj="$(short_home "$cwd")"
    # _rss_get (lib/json.sh) reads the same _RAM_KB_CACHE _pid_ram_mb does, but
    # says so honestly: "unknown" (rendered "?") for a pid the batch `ps`
    # never reported, never a 0 that reads exactly like "verified zero RAM".
    local ram_mb; ram_mb="$(_rss_get "$pid")"
    local ram_disp="$ram_mb" ram_col="$N"
    if [[ "$ram_mb" =~ ^[0-9]+$ ]]; then
      (( ram_mb > 800 )) && ram_col="$R" || { (( ram_mb > 400 )) && ram_col="$Y"; }
    else
      ram_disp="?"
    fi
    local acct_tag=""
    [[ "$account" != "default" ]] && acct_tag="$(printf '  %b[%s]%b' "$M" "$account" "$N")"
    box_line "$(printf '%b[%d]%b %b %b%s%b  %bpid%b %s  %b%sMB%b  %b%s%b%s' \
      "$BOLD" "$i" "$N" "$glyph" "$BOLD" "$sess" "$N" "$DIM" "$N" "$pid" "$ram_col" "$ram_disp" "$N" "$C" "$proj" "$N" "$acct_tag")"

    # line 2: chat title (the human name of the conversation), badged if it
    # arrived here via `transfer` (ledger-backed provenance, not a guess).
    local badge; badge="$(_transfer_badge "$sid" "$account")"
    local tmax=62; [[ -n "$badge" ]] && tmax=44
    local btxt=""; [[ -n "$badge" ]] && btxt="$(printf '   %b%s%b' "$DIM" "$badge" "$N")"
    box_line "$(printf '    %b%s%b%s' "$Y" "$(truncate_str "$(_title_for_sid "$sid" "$cwd" "$(_account_dir_or_default "$account")")" "$tmax")" "$N" "$btxt")"

    # line 3: entry/status/RC
    local rc_disp
    if [[ "$bid" != "-" && -n "$bid" ]]; then
      rc_disp="$(printf '%b %s' "$GLYPH_CHECK" "$(truncate_str "${bid#session_}" 18)")"
    else
      rc_disp="$GLYPH_DASH"
    fi
    box_line "$(printf '  %bentry%b %-13s %bstatus%b %-26s %bRC%b %s' \
      "$DIM" "$N" "$entry" \
      "$DIM" "$N" "$(truncate_str "$status" 26)" \
      "$DIM" "$N" "$rc_disp")"

    # line 4 (only if there's something interesting): updated + flags
    local extra=""
    extra+="$(printf '%bupdated%b %s' "$DIM" "$N" "$(ms_relative "$updated_ms")")"
    [[ -n "$flag" ]] && extra+="  ${GLYPH_ALERT} ${flag}"
    box_line "  $extra"
  done <<<"$rows"
  box_bottom
  LS_COUNT="$i"

  # Warnings summary (compact). Same _DOCTOR_ISSUES-derived count doctor's
  # exit status and JSON issues/processes sections use — no separate `wc -l`
  # over printed lines here either (see cmd_doctor's own comment for why that
  # used to disagree with the real inventory). `_doctor_warnings` is called
  # directly, not via `$(...)`, so its exit status (the array length,
  # clamped) crosses back out via $? for free; its human text is discarded
  # (this summary only ever prints a count, never the lines themselves).
  local warn_count=0
  _doctor_warnings "$rows" >/dev/null 2>&1 || warn_count=$?
  if (( warn_count > 0 )); then
    printf '%b %d warning(s) — run: %bclaude-session doctor%b\n' \
      "$GLYPH_ALERT" "$warn_count" "$BOLD" "$N"
  fi
}

# ---- resume ----------------------------------------------------------------
# Populate the IDX_* maps WITHOUT printing — the picker (fzf or _menu_loop) shows
# its own list, so pre-listing here just scrolls away behind fzf's full-screen UI.
_build_index() {
  IDX_SESS=(); IDX_PID=(); IDX_CWD=(); IDX_SID=(); IDX_ACCOUNT=(); LS_COUNT=0
  local rows; rows="$(_session_rows || true)"
  _ledger_provenance_load
  [[ -z "$rows" ]] && return
  local i=0
  while IFS=$'\t' read -r sess pid cwd entry status sid bid updated_ms alive account; do
    i=$((i+1))
    IDX_SESS[$i]="$sess"; IDX_PID[$i]="$pid"; IDX_CWD[$i]="$cwd"; IDX_SID[$i]="$sid"; IDX_ACCOUNT[$i]="$account"
  done <<<"$rows"
  LS_COUNT="$i"
}

# Go straight to the interactive picker (no pre-listing).
cmd_resume() {
  _build_index
  if (( LS_COUNT == 0 )); then
    printf '%bno sessions to resume — start one: %bclaude-session <project>%b\n' \
      "$DIM" "$BOLD" "$N"
    return 0
  fi
  if (( PLAIN == 1 )) || ! _cs_interactive || [[ ! -t 1 ]]; then
    printf '%bresume needs a terminal. Sessions: %s — attach with: %bclaude-session <project>%b\n' \
      "$DIM" "$LS_COUNT" "$BOLD" "$N"
    return 0
  fi
  if command -v fzf >/dev/null 2>&1; then _fzf_pick "$LS_COUNT"; else _menu_loop "$LS_COUNT"; fi
}

# Attach the session at index N (exec's tmux; only returns on error/no-tmux).
_open_index() {
  local i="$1" sess="${IDX_SESS[$i]:-}"
  [[ -z "$sess" ]] && { printf '%bno session #%s%b\n' "$R" "$i" "$N"; return 1; }
  if [[ "$sess" == "(detached)" || "$sess" == "(vscode)" ]]; then
    printf '%b#%s is %s — not a reattachable tmux (this shell or a VS Code chat).%b\n' \
      "$Y" "$i" "$sess" "$N"
    return 1
  fi
  printf '%battaching %s …%b\n' "$DIM" "$sess" "$N"
  _enter_session "$sess"
}

# Pure-bash picker (no fzf): number to open, p<number> to preview.
_menu_loop() {
  local maxn="$1" ans num i
  # compact numbered list (fzf path shows its own; this one must print it itself)
  for ((i=1;i<=maxn;i++)); do
    local acct_tag=""
    [[ "${IDX_ACCOUNT[$i]}" != "default" ]] && acct_tag="$(printf ' %b[%s]%b' "$M" "${IDX_ACCOUNT[$i]}" "$N")"
    local badge; badge="$(_transfer_badge "${IDX_SID[$i]}" "${IDX_ACCOUNT[$i]}")"
    local btxt=""; [[ -n "$badge" ]] && btxt="$(printf '  %b%s%b' "$DIM" "$badge" "$N")"
    printf '%b[%d]%b %b%-22s%b%s %b%s%b%s\n' \
      "$BOLD" "$i" "$N" "$BOLD" "${IDX_SESS[$i]}" "$N" "$acct_tag" \
      "$Y" "$(truncate_str "$(_title_for_sid "${IDX_SID[$i]}" "${IDX_CWD[$i]}" "$(_account_dir_or_default "${IDX_ACCOUNT[$i]}")")" 52)" "$N" "$btxt"
  done
  while true; do
    printf '\n%bselect%b  #=open · p#=preview · r=refresh · q=quit %b>%b ' \
      "$BOLD" "$N" "$BOLD" "$N"
    read -r ans || break
    case "$ans" in
      ''|q|Q)   break ;;
      r|R)      exec "$0" resume ;;
      p[0-9]*)  num="${ans#p}"
                if (( num>=1 && num<=maxn )); then printf '\n'; _preview_for_sid "${IDX_SID[$num]}" "${IDX_CWD[$num]}" "$(_account_dir_or_default "${IDX_ACCOUNT[$num]}")"; else echo "?"; fi ;;
      [0-9]*)   if (( ans>=1 && ans<=maxn )); then _open_index "$ans"; else echo "?"; fi ;;
      *)        echo "?" ;;
    esac
  done
}

# fzf picker with a live preview pane (used when fzf is installed).
# Fields: 1=sid  2=sess  3=display(shown)  4=cwd(hidden)  5=account(hidden) — 4 and 5 feed the preview hook.
_fzf_pick() {
  local maxn="$1" i line sid sess input=""
  for ((i=1;i<=maxn;i++)); do
    local acct_tag=""
    [[ "${IDX_ACCOUNT[$i]}" != "default" ]] && acct_tag="$(printf '  %b[%s]%b' "$M" "${IDX_ACCOUNT[$i]}" "$N")"
    local badge; badge="$(_transfer_badge "${IDX_SID[$i]}" "${IDX_ACCOUNT[$i]}")"
    local btxt=""; [[ -n "$badge" ]] && btxt="$(printf '  %b%s%b' "$DIM" "$badge" "$N")"
    input+="$(printf '%s\t%s\t%b%s%b  %b%s%b%s%s\t%s\t%s' \
      "${IDX_SID[$i]}" "${IDX_SESS[$i]}" \
      "$BOLD" "${IDX_SESS[$i]}" "$N" "$Y" "$(_title_for_sid "${IDX_SID[$i]}" "${IDX_CWD[$i]}" "$(_account_dir_or_default "${IDX_ACCOUNT[$i]}")")" "$N" "$acct_tag" "$btxt" \
      "${IDX_CWD[$i]}" "${IDX_ACCOUNT[$i]}")"$'\n'
  done
  line="$(printf '%s' "$input" | fzf --ansi --delimiter='\t' --with-nth=3 \
      --height=90% --reverse --prompt='open chat > ' \
      --preview="$0 _preview {1} {4} {5}" --preview-window='right:60%:wrap')" || return 0
  sid="$(cut -f1 <<<"$line")"; sess="$(cut -f2 <<<"$line")"
  [[ -z "$sess" ]] && return 0
  if [[ "$sess" == "(detached)" || "$sess" == "(vscode)" ]]; then
    printf '%b%s is not a reattachable tmux.%b\n' "$Y" "$sess" "$N"; return 0
  fi
  _enter_session "$sess"
}


# ---- kill (interactive) ----------------------------------------------------
cmd_kill() {
  _build_index
  if (( LS_COUNT == 0 )); then
    printf '%bno sessions to kill — nothing running.%b\n' "$DIM" "$N"
    return 0
  fi
  if (( PLAIN == 1 )) || ! _cs_interactive || [[ ! -t 1 ]]; then
    printf '%bkill needs a terminal. Use: %bclaude-session kill <session>%b\n' "$DIM" "$BOLD" "$N"
    return 0
  fi

  local i ram_mb ram_col title
  printf '\n'
  for ((i=1; i<=LS_COUNT; i++)); do
    ram_mb="$(_pid_ram_mb "${IDX_PID[$i]}")"
    ram_col="$N"
    (( ram_mb > 800 )) && ram_col="$R" || { (( ram_mb > 400 )) && ram_col="$Y"; }
    title="$(truncate_str "$(_title_for_sid "${IDX_SID[$i]}" "${IDX_CWD[$i]}" "$(_account_dir_or_default "${IDX_ACCOUNT[$i]}")")" 48)"
    local acct_tag=""
    [[ "${IDX_ACCOUNT[$i]}" != "default" ]] && acct_tag="$(printf '  %b[%s]%b' "$M" "${IDX_ACCOUNT[$i]}" "$N")"
    printf '  %b[%d]%b  %b%-28s%b  %b%4sMB%b  %b%s%b%s\n' \
      "$BOLD" "$i" "$N" \
      "$BOLD" "${IDX_SESS[$i]}" "$N" \
      "$ram_col" "$ram_mb" "$N" \
      "$Y" "$title" "$N" "$acct_tag"
  done

  local total_mb=0
  for ((i=1; i<=LS_COUNT; i++)); do
    total_mb=$(( total_mb + $(_pid_ram_mb "${IDX_PID[$i]}") ))
  done
  printf '\n  %bTotal: %d session(s)  %sMB used%b\n' "$DIM" "$LS_COUNT" "$total_mb" "$N"
  printf '  %b#=toggle · a=all · k=kill selected · q=quit%b\n' "$DIM" "$N"

  local to_kill=() ans num found new_kill n sess pid
  while true; do
    local sel_str=""
    if (( ${#to_kill[@]} > 0 )); then
      sel_str=" $(printf '%b[%b' "$R" "$N")"
      for n in "${to_kill[@]}"; do sel_str+="$n "; done
      sel_str+="$(printf '%b]%b' "$R" "$N")"
    fi
    printf '\n%bkill%b%s %b>%b ' "$BOLD" "$N" "$sel_str" "$BOLD" "$N"
    read -r ans || break
    case "$ans" in
      ''|q|Q) printf '%bcancelled%b\n' "$DIM" "$N"; break ;;
      a|A)
        to_kill=()
        for ((i=1; i<=LS_COUNT; i++)); do to_kill+=("$i"); done
        printf '%bselected all (%d sessions)%b\n' "$Y" "${#to_kill[@]}" "$N"
        ;;
      k|K)
        if (( ${#to_kill[@]} == 0 )); then
          printf '%bnothing selected — pick numbers first%b\n' "$DIM" "$N"; continue
        fi
        printf '%bAbout to kill:%b\n' "$R" "$N"
        for num in "${to_kill[@]}"; do
          ram_mb="$(_pid_ram_mb "${IDX_PID[$num]}")"
          printf '  [%d] %s  %sMB\n' "$num" "${IDX_SESS[$num]}" "$ram_mb"
        done
        printf '%bConfirm kill %d session(s)? [y/N]%b ' "$R" "${#to_kill[@]}" "$N"
        read -r confirm
        if [[ "$confirm" == [yY] ]]; then
          for num in "${to_kill[@]}"; do
            sess="${IDX_SESS[$num]}"; pid="${IDX_PID[$num]}"
            if tmux kill-session -t "$sess" 2>/dev/null; then
              printf '  %b✓ tmux %s killed%b\n' "$Y" "$sess" "$N"
            else
              printf '  %b- tmux %s not found (may already be gone)%b\n' "$DIM" "$sess" "$N"
            fi
            if kill -TERM "$pid" 2>/dev/null; then
              printf '  %b✓ SIGTERM → pid %s%b\n' "$Y" "$pid" "$N"
            fi
          done
          printf '\n'
          break
        else
          printf '%bcancelled%b\n' "$DIM" "$N"
        fi
        ;;
      [0-9]*)
        num="$ans"
        if (( num >= 1 && num <= LS_COUNT )); then
          found=0; new_kill=()
          for n in "${to_kill[@]}"; do
            (( n == num )) && found=1 || new_kill+=("$n")
          done
          if (( found == 0 )); then
            new_kill+=("$num")
            ram_mb="$(_pid_ram_mb "${IDX_PID[$num]}")"
            printf '  %b+ [%d] %s  %sMB  — selected%b\n' "$Y" "$num" "${IDX_SESS[$num]}" "$ram_mb" "$N"
          else
            printf '  %b- [%d] %s  — deselected%b\n' "$DIM" "$num" "${IDX_SESS[$num]}" "$N"
          fi
          to_kill=("${new_kill[@]}")
        else
          printf '  ?\n'
        fi
        ;;
      *) printf '  ?\n' ;;
    esac
  done
}
# ---- reap (kill orphaned dev processes found by _orphan_rows) -------------
# Every live descendant of a pid, walked via ppid links from a fresh `ps`
# snapshot — children printed before their parent (root last), so callers can
# kill the whole subtree leaves-first.
_pid_descendants() {
  local root="$1"
  local rows; rows="$(ps -eo pid=,ppid= 2>/dev/null || true)"
  [[ -z "$rows" ]] && { printf '%s\n' "$root"; return 0; }
  declare -A children
  local pid ppid
  while read -r pid ppid; do
    [[ -z "$pid" ]] && continue
    children[$ppid]+=" $pid"
  done <<<"$rows"

  local -a queue=("$root") order=()
  local idx=0
  while (( idx < ${#queue[@]} )); do
    local cur="${queue[$idx]}"; idx=$((idx+1))
    order+=("$cur")
    local k
    for k in ${children[$cur]:-}; do queue+=("$k"); done
  done
  local i
  for (( i=${#order[@]}-1; i>=0; i-- )); do
    printf '%s\n' "${order[$i]}"
  done
}

# Re-verify a single pid still matches orphan criteria immediately before
# killing it (processes are moving targets — a parent could reappear, or the
# pid could already be gone), then TERM its subtree, wait, KILL survivors.
# Never touches pid 1 or ourselves. Returns 1 (skip) on any safety failure.
_reap_one() {
  local pid="$1"
  if [[ -z "$pid" || "$pid" == "$$" || "$pid" == "1" ]]; then
    printf '  %bskip pid %s — refuses to touch self/init%b\n' "$R" "${pid:-?}" "$N"
    return 1
  fi
  if ! _proc_alive "$pid"; then
    printf '  %b- pid %s already gone%b\n' "$DIM" "$pid" "$N"
    return 1
  fi
  local ppid comm
  ppid="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')"
  comm="$(_proc_comm "$pid")"
  if [[ "$ppid" != "1" ]]; then
    printf '  %bskip pid %s — no longer an orphan (ppid=%s)%b\n' "$Y" "$pid" "${ppid:-?}" "$N"
    return 1
  fi
  if [[ "$comm" =~ $_ORPHAN_PROTECTED_PATTERN ]]; then
    printf '  %bskip pid %s — re-check says protected (%s)%b\n' "$Y" "$pid" "$comm" "$N"
    return 1
  fi

  local -a victims=()
  local v
  while IFS= read -r v; do victims+=("$v"); done < <(_pid_descendants "$pid")
  for v in "${victims[@]+"${victims[@]}"}"; do
    [[ "$v" == "$$" || "$v" == "1" || -z "$v" ]] && continue
    kill -TERM "$v" 2>/dev/null || true
  done
  sleep 5
  for v in "${victims[@]+"${victims[@]}"}"; do
    [[ "$v" == "$$" || "$v" == "1" || -z "$v" ]] && continue
    _proc_alive "$v" && kill -9 "$v" 2>/dev/null || true
  done
  printf '  %b✓ reaped pid %s (%s)%b\n' "$G" "$pid" "$comm" "$N"
  return 0
}

# `doctor --reap`: list, confirm, kill. Never kills unattended without --force.
# Classifies every candidate with _orphan_activity BEFORE printing or
# prompting — an orphan with real work still running in its subtree (an agent
# job, a build, a test suite several levels down) must never be killed just
# because the root pid itself is idle. See _orphan_activity for the full why.
#
# Three buckets, not two, since _orphan_activity now returns idle/active/
# suspect: idle is always reaped, active is NEVER reaped (--force does not
# touch it — a genuinely progressing subtree is never overridable), and
# suspect is reaped ONLY when --force is given. This is the actual fix for
# the safety defect task-5-brief.md Step 4b measured on 2026-08-03: a
# spinning `*:build` process read "active" by raw CPU (so it was never in
# idle_pids) and "hung" by the stuck-build check, and --force did not help
# because it was never consulted before this split — a process spinning at a
# third of a core could not be removed by this tool at all. Now a build that
# is genuinely busy stays un-killable no matter what; a build that LOOKS busy
# but has made no I/O progress past the stuck threshold can be force-reaped,
# which is the path this tool lacked (the only prior way out was a bare
# `pkill -f`, which has no guard at all).
_do_reap() {
  local orphan_ps_rows; orphan_ps_rows="$(_ps_snapshot_rows || true)"
  local orphan_rows; orphan_rows="$(_orphan_rows "$orphan_ps_rows" || true)"
  if [[ -z "$orphan_rows" ]]; then
    printf '%bnothing to reap%b\n' "$DIM" "$N"
    return 0
  fi

  local -a idle_pids=() active_pids=() suspect_pids=()
  local -A act_reason act_state
  local pid etimes pcpu comm args act state reason subtree
  while IFS=$'\t' read -r pid etimes pcpu comm args; do
    [[ -z "$pid" ]] && continue
    act="$(_orphan_activity "$pid" "$orphan_ps_rows")"
    IFS=$'\t' read -r state reason subtree <<<"$act"
    act_state[$pid]="$state"
    act_reason[$pid]="$reason"
    case "$state" in
      active)  active_pids+=("$pid") ;;
      suspect) suspect_pids+=("$pid") ;;
      *)       idle_pids+=("$pid") ;;
    esac
  done <<<"$orphan_rows"

  printf '\n%borphans found:%b\n' "$BOLD" "$N"
  while IFS=$'\t' read -r pid etimes pcpu comm args; do
    [[ -z "$pid" ]] && continue
    case "${act_state[$pid]:-idle}" in
      active)
        printf '  pid %-8s %-8s %5s%%  %-50s  %b(active — will be skipped)%b\n' \
          "$pid" "$(_fmt_age_hm "$etimes")" "$pcpu" "$(truncate_str "$(_short_cmd "$args")" 50)" "$Y" "$N"
        ;;
      suspect)
        printf '  pid %-8s %-8s %5s%%  %-50s  %b(suspected hung — needs --force)%b\n' \
          "$pid" "$(_fmt_age_hm "$etimes")" "$pcpu" "$(truncate_str "$(_short_cmd "$args")" 50)" "$R" "$N"
        ;;
      *)
        printf '  pid %-8s %-8s %5s%%  %s\n' \
          "$pid" "$(_fmt_age_hm "$etimes")" "$pcpu" "$(truncate_str "$(_short_cmd "$args")" 50)"
        ;;
    esac
  done <<<"$orphan_rows"

  local -a reap_pids=("${idle_pids[@]+"${idle_pids[@]}"}")
  (( FORCE == 1 )) && reap_pids+=("${suspect_pids[@]+"${suspect_pids[@]}"}")

  if (( ${#reap_pids[@]} == 0 )); then
    if (( ${#suspect_pids[@]} > 0 )); then
      printf '\n%bnothing reaped — %d suspected-hung process(es) need --force to override (see above); everything else has active work in its subtree%b\n' \
        "$Y" "${#suspect_pids[@]}" "$N"
    else
      printf '\n%bnothing reaped — every orphan has active work in its subtree (see above); rerun once it finishes%b\n' \
        "$Y" "$N"
    fi
    return 0
  fi

  if (( FORCE == 0 )); then
    if _cs_interactive; then
      printf '\n%breap %d orphaned process(es)? [y/N]%b ' "$R" "${#reap_pids[@]}" "$N"
      local confirm; read -r confirm || confirm=""
      if [[ "$confirm" != [yY] ]]; then
        printf '%bcancelled%b\n' "$DIM" "$N"
        return 0
      fi
    else
      printf '%bclaude-session doctor --reap: refusing to kill without confirmation on a non-interactive stdin — pass --force to proceed unattended%b\n' \
        "$R" "$N" >&2
      return 2
    fi
  fi

  # CRITICAL SAFETY: when $ORPHAN_PS_SRC is set, the process table is a test
  # fixture — its pids (100001, 200003, …) are arbitrary numbers that can
  # coincide with REAL, live pids on whatever host runs the test. Calling
  # kill() on them would be indistinguishable from killing real processes on
  # this box. So fixture mode is ALWAYS a dry run, no matter --force: print
  # exactly what would happen and stop before any kill is issued. This is the
  # only branch allowed to run non-interactively against a fake process table.
  if [[ -n "${ORPHAN_PS_SRC:-}" ]]; then
    printf '\n%b[dry-run] fixture process table ($ORPHAN_PS_SRC set) — no kill will be issued%b\n' "$Y" "$N"
    local p dryrun_skipped=${#active_pids[@]}
    for p in "${reap_pids[@]}"; do
      if [[ "${act_state[$p]:-idle}" == "suspect" ]]; then
        printf '  [dry-run] would reap pid %s — forced past a suspected-hung guard: %s\n' "$p" "${act_reason[$p]}"
      else
        printf '  [dry-run] would reap pid %s\n' "$p"
      fi
    done
    for p in "${active_pids[@]+"${active_pids[@]}"}"; do
      printf '  [dry-run] would skip pid %s — active work in its subtree: %s\n' "$p" "${act_reason[$p]}"
    done
    if (( FORCE == 0 )); then
      for p in "${suspect_pids[@]+"${suspect_pids[@]}"}"; do
        printf '  [dry-run] would skip pid %s — %s (rerun with --force to override)\n' "$p" "${act_reason[$p]}"
        dryrun_skipped=$((dryrun_skipped+1))
      done
    fi
    printf '\n%b[dry-run] reaped 0, skipped %d (busy), skipped 0 (failed re-verification)%b\n' \
      "$BOLD" "$dryrun_skipped" "$N"
    return 0
  fi

  local reaped=0 busy_skipped=0 failed_skipped=0
  local p
  for p in "${active_pids[@]+"${active_pids[@]}"}"; do
    printf '  %bskip pid %s — active work in its subtree: %s%b\n' "$Y" "$p" "${act_reason[$p]}" "$N"
    busy_skipped=$((busy_skipped+1))
  done
  if (( FORCE == 0 )); then
    for p in "${suspect_pids[@]+"${suspect_pids[@]}"}"; do
      printf '  %bskip pid %s — %s (rerun with --force to override)%b\n' "$Y" "$p" "${act_reason[$p]}" "$N"
      busy_skipped=$((busy_skipped+1))
    done
  fi
  for p in "${reap_pids[@]}"; do
    if _reap_one "$p"; then reaped=$((reaped+1)); else failed_skipped=$((failed_skipped+1)); fi
  done
  printf '\n%breaped %d, skipped %d (busy), skipped %d (failed re-verification)%b\n' \
    "$BOLD" "$reaped" "$busy_skipped" "$failed_skipped" "$N"
}

# ---- doctor ----------------------------------------------------------------
cmd_doctor() {
  # --json and the human path below now derive their count from the exact
  # SAME inventory (_DOCTOR_ISSUES, populated by _doctor_warnings — every
  # check (1)-(9) appends to it, see that function's own comment): the
  # issues+processes item counts here, the exit status below, and the human
  # "N issue(s) flagged" line cannot disagree by construction, because there
  # is only one count in the system, read two different ways (a jq length-sum
  # over the emitted document here; a bash array length via $? on the human
  # path, since the array itself cannot cross the subshell _doctor_warnings
  # runs in when its text output is captured — but a plain integer exit
  # status can). 0 issues means all clear on both paths, always.
  if (( JSON_OUT == 1 )); then
    local envdoc envrc
    envdoc="$(_json_envelope "chats,issues,processes")"; envrc=$?
    printf '%s\n' "$envdoc"
    (( envrc != 0 )) && exit "$envrc"
    local n
    n="$(jq -n --argjson d "$envdoc" \
      '($d.sections.issues.items // []) as $i | ($d.sections.processes.items // []) as $p | ($i|length) + ($p|length)' \
      2>/dev/null)"
    [[ "$n" =~ ^[0-9]+$ ]] || n=0
    (( n > 250 )) && n=250
    exit "$n"
  fi
  # Scan once, hand the result down — _doctor_warnings used to rescan on its
  # own, and the "all clear" branch below rescanned yet again just to print a
  # count. Same string both times, so this is not merely faster but strictly
  # more consistent: one snapshot for the whole `doctor` run.
  local rows; rows="$(_session_rows || true)"
  local out count=0
  out="$(_doctor_warnings "$rows")" || count=$?

  box_top "Doctor"
  if (( count == 0 )); then
    # `_session_rows | wc -l` (the original form) counted newlines straight
    # off the pipe. `$rows` above already had its one trailing newline
    # stripped by that command substitution, and `<<<"$rows"` adds exactly
    # one back, so counting it this way lands on the identical number for
    # every non-empty scan — except a truly empty one, where the herestring's
    # own synthetic newline would otherwise be miscounted as one line.
    local session_count=0
    [[ -n "$rows" ]] && session_count="$(wc -l <<<"$rows")"
    box_msg "$GLYPH_CHECK " "all clear ($session_count session(s) checked)"
  else
    # Each line from _doctor_warnings starts with a glyph (ANSI) followed by a space
    # and the message. Pass through box_msg for wrapping. Indented continuation
    # lines (start with 4 spaces) get rendered with their existing indent.
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      if [[ "$line" == "    "* ]]; then
        # already-indented continuation
        box_msg "    " "${line#    }" "      "
      else
        # extract the leading "<glyph> " prefix (everything up to the first non-ANSI space)
        local prefix=""
        local body="$line"
        if [[ "$line" =~ ^($'\033'\[[0-9\;]*m)*[^[:space:]]+\  ]]; then
          prefix="${BASH_REMATCH[0]}"
          body="${line:${#prefix}}"
        fi
        box_msg "$prefix" "$body"
      fi
    done <<<"$out"
    box_blank
    box_line "$(printf '%b%d issue(s) flagged%b' "$Y" "$count" "$N")"
  fi
  box_bottom

  if (( REAP == 1 )); then
    # --reap has its own exit semantics (docs/doctor-orphans.md, "Exit status"):
    # the issue-count contract below is for plain `doctor`, so the reap path's
    # status is what propagates here.
    _do_reap
    return $?
  fi

  # docs/doctor-orphans.md promises: "`doctor` (without `--reap`) exits with the
  # number of issues it found — 0 means all clear ... usable directly in scripts
  # or a keepalive-adjacent monitoring loop without parsing its human-readable
  # output." `$count` is already the exact _DOCTOR_ISSUES inventory count
  # (clamped to 250 inside _doctor_warnings, before it ever became this
  # exit status) — no second clamp needed here.
  return "$count"
}

# ---- accounts subcommand ----------------------------------------------------
cmd_accounts() {
  local sub="${1:-ls}"
  shift || true
  # _JSON_READY_VERBS gates by verb ("accounts"), not by subcommand — add/rm
  # have no emitter here (only `ls` does, via lib/json.sh). Without this,
  # `accounts add --json` would pass the top-level guard and then silently run
  # its ordinary interactive/human path, discarding the --json request instead
  # of erroring on it.
  if (( JSON_OUT == 1 )) && [[ "$sub" != "ls" ]]; then
    echo "claude-session: --json is not available for 'accounts $sub' in this build" >&2
    exit 2
  fi
  case "$sub" in
    add) cmd_accounts_add "$@" ;;
    ls)  cmd_accounts_ls ;;
    rm)  cmd_accounts_rm "$@" ;;
    *)   echo "claude-session accounts: unknown subcommand '$sub' (use add, ls, or rm)" >&2; exit 2 ;;
  esac
}

cmd_accounts_add() {
  local name="${1:-}"
  shift || true
  local desc="$*"
  [[ -n "$name" ]] || { echo "claude-session accounts add: name required" >&2; exit 2; }
  [[ "$name" == "default" ]] && { echo "claude-session accounts add: 'default' is reserved for the built-in account" >&2; exit 2; }
  [[ "$name" =~ ^[a-zA-Z0-9_-]+$ ]] || { echo "claude-session accounts add: name must match [a-zA-Z0-9_-]+" >&2; exit 2; }

  local dir
  dir="$(_account_config_dir "$name" 2>/dev/null)" || dir=""
  if [[ -z "$dir" ]]; then
    dir="$HOME/.claude-accounts/$name"
    mkdir -p "$(dirname "$ACCOUNTS_CONF")"
    if [[ ! -f "$ACCOUNTS_CONF" ]]; then
      cat > "$ACCOUNTS_CONF" <<'HEADER'
# ~/.config/claude-helpers/accounts.conf
#
# Registry of extra Claude Code accounts, each with its own isolated
# CLAUDE_CONFIG_DIR (credentials, settings, session history, project data).
# The default account (plain ~/.claude) always exists and needs no entry
# here. Managed by `claude-session accounts add/ls/rm` — hand-editable too.
#
# Format: account <name> <config-dir> '<description>'
HEADER
    fi
    printf 'account %s %s %s\n' "$name" "$dir" "$(printf '%q' "$desc")" >> "$ACCOUNTS_CONF"
    echo "claude-session: registered account '$name' -> $dir" >&2
  fi
  mkdir -p "$dir"

  echo "claude-session: launching claude under '$name' — run /login, then Ctrl-D to finish setup." >&2
  CLAUDE_CONFIG_DIR="$dir" claude
}

cmd_accounts_ls() {
  if (( JSON_OUT == 1 )); then _json_section_accounts; return 0; fi
  box_top "Claude accounts"
  local first=1
  while IFS=$'\t' read -r name dir; do
    if (( !first )); then box_blank; fi
    first=0
    local desc="${ACCT_DESC[$name]:-}"
    [[ "$name" == "default" ]] && desc="${desc:-plain ~/.claude, no CLAUDE_CONFIG_DIR}"
    local logged_in="$GLYPH_DASH"
    [[ -f "$dir/.credentials.json" ]] && logged_in="$GLYPH_CHECK"
    box_line "$(printf '%b%-10s%b %b %b%s%b' "$BOLD" "$name" "$N" "$logged_in" "$DIM" "$(short_home "$dir")" "$N")"
    [[ -n "$desc" ]] && box_line "$(printf '  %b%s%b' "$Y" "$desc" "$N")"
  done < <(_all_accounts)
  box_bottom
}

cmd_accounts_rm() {
  local name="${1:-}"
  [[ -n "$name" ]] || { echo "claude-session accounts rm: name required" >&2; exit 2; }
  [[ "$name" == "default" ]] && { echo "claude-session accounts rm: cannot remove the default account" >&2; exit 2; }
  local dir
  dir="$(_account_config_dir "$name")" || { echo "claude-session accounts rm: unknown account '$name'" >&2; exit 2; }
  [[ -f "$ACCOUNTS_CONF" ]] || { echo "claude-session accounts rm: no accounts.conf found" >&2; exit 2; }
  local tmp; tmp="$(mktemp)"
  local grep_rc=0
  grep -vE "^account[[:space:]]+$name([[:space:]]|\$)" "$ACCOUNTS_CONF" > "$tmp" || grep_rc=$?
  if (( grep_rc >= 2 )); then
    rm -f "$tmp"
    echo "claude-session accounts rm: failed to filter accounts.conf (grep exit $grep_rc) — registry left untouched" >&2
    exit 1
  fi
  mv "$tmp" "$ACCOUNTS_CONF"
  echo "claude-session: unregistered '$name'. Config dir kept at $dir — delete manually if you want:" >&2
  echo "  rm -rf $(printf '%q' "$dir")" >&2
}








# ---- dup-guard helper ------------------------------------------------------
# Prints offender description if this project+account already has a bridged
# Claude; 0 = yes. Scoped to the target account's own session-state dir, so a
# different account may hold its own bridge in the same directory.
_project_already_bridged() {
  local project_dir="$1" account="${2:-default}"
  local sdir; sdir="$(_account_dir_or_default "$account")/sessions"
  shopt -s nullglob
  local f
  for f in "$sdir"/*.json; do
    local pid cwd bridge sess
    pid="$(jq -r '.pid // empty' "$f")"
    [[ -z "$pid" ]] && continue
    _proc_alive "$pid" || continue
    cwd="$(jq -r '.cwd // empty' "$f")"
    [[ "$cwd" != "$project_dir" ]] && continue
    bridge="$(jq -r '.bridgeSessionId // empty' "$f")"
    [[ -z "$bridge" ]] && continue
    sess="$(owner_tmux "$pid")"
    [[ -z "$sess" ]] && sess="(detached/vscode)"
    echo "tmux=$sess pid=$pid bridge=${bridge#session_}"
    return 0
  done
  return 1
}

# ---- argument parsing ------------------------------------------------------
# Split off a `--` passthrough tail before flag parsing (everything after `--`
# is forwarded to native claude verbatim; pre-`--` flags like --account still apply).
PASSTHROUGH=0; NATIVE_ARGS=()
_pre=(); _seen_dd=0
for a in "$@"; do
  if (( _seen_dd )); then NATIVE_ARGS+=("$a"); continue; fi
  if [[ "$a" == "--" ]]; then _seen_dd=1; PASSTHROUGH=1; continue; fi
  _pre+=("$a")
done
set -- "${_pre[@]+"${_pre[@]}"}"

FORCE=0
PLAIN=0
REAP=0
SHOW_VERSION=0
JSON_OUT=0; DRY_RUN=0; ASSUME_YES=0; ACK_DIGESTS=""
SCHED_WORK=""; SCHED_DAYS=""; SCHED_TZ=""; SCHED_MIGRATE=0; SCHED_FROM_NOW=0
QUOTA_RESET_AT=""; QUOTA_SOURCE=""; QUOTA_CLEAR=0
# CHAT_LIMIT is 200, not 50: once titles come from the persisted index, a window
# costs one pass over that index rather than one tail+jq per row, so the window
# is bounded by row-building cost instead of by I/O.
UI_PLACE=""; SNAP_ONLY=""; SNAP_SIDS=""; CHAT_LIMIT=200
CLIP_GET=0; CLIP_KEEP=0; TI_REBUILD=0
HANDOFF=""
CLAUDE_MODE="interactive"
ACCOUNT=""
TO_ACCOUNT=""
FROM_ACCOUNT="default"
TRANSFER_MOVE=0
TRANSFER_LIMIT=50
TRANSFER_LAUNCH=0
SCHED_CHAT=""; SCHED_NEW=0; SCHED_WHEN_KIND=""; SCHED_WHEN_VAL=""; SCHED_TIMEOUT=""; SCHED_CWD=""
SCHED_MODEL=""; SCHED_ALL_ACCOUNTS=0
SCHED_AT=""; SCHED_IN=""
# Normalize `--flag value` into `--flag=value` for our own value-taking options,
# so the matcher below only has to know one shape.
#
# Only the `=` shape used to be matched, so `--account work` fell through to the
# positional bucket: the account was silently ignored (the session launched under
# the DEFAULT account) and the stray `--account` was handed to `claude`, which has
# no such flag. Launching under the wrong account is a data-safety bug, not a
# cosmetic one — so a value-taking option with nothing after it is now a hard
# error rather than something quietly reinterpreted as a positional.
#
# Deliberately excludes claude's own value flags (--model, --agent, --session-id):
# those must reach claude untouched, which is why this list is explicit and not
# "anything that looks like a flag".
_CS_VALUE_FLAGS=" --handoff --mode --account --to --from --limit --chat --every --daily-at --once --timeout --cwd --at --in --ack --work --days --tz --reset-at --place --only --sids --limit-chats "
_norm=()
while (( $# )); do
  if [[ -n "$1" && "$_CS_VALUE_FLAGS" == *" $1 "* ]]; then
    [[ $# -ge 2 ]] || { echo "claude-session: $1 requires a value (e.g. $1=VALUE or $1 VALUE)" >&2; exit 2; }
    _norm+=("$1=$2"); shift 2; continue
  fi
  _norm+=("$1"); shift
done
set -- "${_norm[@]+"${_norm[@]}"}"

ARGS=()
for a in "$@"; do
  case "$a" in
    --force|-f)   FORCE=1 ;;
    --plain)      PLAIN=1 ;;
    --reap)       REAP=1 ;;
    --version)    SHOW_VERSION=1 ;;
    --json)         JSON_OUT=1 ;;
    --dry-run)      DRY_RUN=1 ;;
    --yes)          ASSUME_YES=1 ;;
    --ack=*)        ACK_DIGESTS="${a#*=}" ;;
    --work=*)       SCHED_WORK="${a#*=}" ;;
    --days=*)       SCHED_DAYS="${a#*=}" ;;
    --migrate)      SCHED_MIGRATE=1 ;;
    --from-now)     SCHED_FROM_NOW=1 ;;
    --reset-at=*)   QUOTA_RESET_AT="${a#*=}" ;;
    --reported)     QUOTA_SOURCE="reported" ;;
    --derived)      QUOTA_SOURCE="derived" ;;
    --clear)        QUOTA_CLEAR=1 ;;
    --place=*)      UI_PLACE="${a#*=}" ;;
    --only=*)       SNAP_ONLY="${a#*=}" ;;
    --limit-chats=*) CHAT_LIMIT="${a#*=}" ;;
    --sids=*)       SNAP_SIDS="${a#*=}" ;;   # the window `_titles` resolves
    --rebuild)      TI_REBUILD=1 ;;          # the one full title-index build
    --get)          CLIP_GET=1 ;;            # read the fallback clipboard buffer
    --keep)         CLIP_KEEP=1 ;;           # --get without clearing the buffer
    # The named timezone a wall-clock schedule is anchored to. An unzoned
    # OnCalendar is read in the SYSTEM zone, which on this host means a working
    # day typed as 09:00 fires at 12:00 local — a plausible-looking wrong answer.
    --tz=*)         SCHED_TZ="${a#*=}" ;;
    # -p means --plain for own verbs; for native routing it's re-injected as
    # claude's --print alias at the native fall-through dispatch (never in ARGS,
    # so own-verb dispatch stays clean: `kill -p` → cmd_kill, `-p kill` → own kill).
    -p)           PLAIN=1 ;;
    --handoff=*)  HANDOFF="${a#*=}" ;;
    --mode=*)     CLAUDE_MODE="${a#*=}" ;;
    --account=*)  ACCOUNT="${a#*=}" ;;
    --to=*)       TO_ACCOUNT="${a#*=}" ;;
    --from=*)     FROM_ACCOUNT="${a#*=}" ;;
    --move)       TRANSFER_MOVE=1 ;;
    --limit=*)    TRANSFER_LIMIT="${a#*=}" ;;
    --launch)     TRANSFER_LAUNCH=1 ;;
    --chat=*)      SCHED_CHAT="${a#*=}" ;;
    --new)         SCHED_NEW=1 ;;
    --every=*)     SCHED_WHEN_KIND="every";    SCHED_WHEN_VAL="${a#*=}" ;;
    --daily-at=*)  SCHED_WHEN_KIND="daily-at"; SCHED_WHEN_VAL="${a#*=}" ;;
    --once=*)      SCHED_WHEN_KIND="once";     SCHED_WHEN_VAL="${a#*=}" ;;
    --timeout=*)   SCHED_TIMEOUT="${a#*=}" ;;
    --cwd=*)       SCHED_CWD="${a#*=}" ;;
    --all-accounts) SCHED_ALL_ACCOUNTS=1 ;;
    --at=*)        SCHED_AT="${a#*=}" ;;
    --in=*)        SCHED_IN="${a#*=}" ;;
    -h|--help)    awk 'NR>1 && /^set -euo pipefail/{exit} NR>1{print}' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)            ARGS+=("$a") ;;
  esac
done
# CLAUDE_SESSION_UI=1 is the app's contract with the core: never prompt on
# stdin, never colorize, diagnostics to stderr. --json implies all three,
# because a JSON document with an ANSI escape or a y/N prompt in it is garbage.
if [[ "${CLAUDE_SESSION_UI:-0}" == 1 ]] || (( JSON_OUT == 1 )); then
  CS_NONINTERACTIVE=1; export CS_NONINTERACTIVE
  NO_COLOR=1; export NO_COLOR
  _ui_disable_color
fi
# `"${ARGS[@]:-}"` expands to one EMPTY argument when ARGS is empty, which makes
# $# read 1 for a bare `claude-session`. Use the +alternate form so empty really
# means zero arguments.
set -- "${ARGS[@]+"${ARGS[@]}"}"
a1="${1:-}"; a2="${2:-}"

case "$CLAUDE_MODE" in
  interactive|plan|autopilot) ;;
  *) echo "claude-session: invalid mode '$CLAUDE_MODE' (use interactive, plan, or autopilot)" >&2; exit 2 ;;
esac
[[ "$TRANSFER_LIMIT" =~ ^[0-9]+$ ]] \
  || { echo "claude-session: --limit must be a non-negative integer (0 = no cap)" >&2; exit 2; }
if [[ -n "$HANDOFF" ]]; then
  HANDOFF="$(_readlink_f "$HANDOFF" 2>/dev/null || true)"
  [[ -n "$HANDOFF" && -r "$HANDOFF" ]] \
    || { echo "claude-session: --handoff must name a readable file" >&2; exit 2; }
fi

ACCOUNT_DIR=""
if [[ -n "$ACCOUNT" && "$ACCOUNT" != "default" ]]; then
  [[ "$ACCOUNT" =~ ^[a-zA-Z0-9_-]+$ ]] \
    || { echo "claude-session: --account name must match [a-zA-Z0-9_-]+" >&2; exit 2; }
  ACCOUNT_DIR="$(_account_config_dir "$ACCOUNT")" \
    || { echo "claude-session: unknown account '$ACCOUNT' — register it first: claude-session accounts add $ACCOUNT" >&2; exit 2; }
fi
ACCOUNT_SUFFIX=""
[[ -n "$ACCOUNT" && "$ACCOUNT" != "default" ]] && ACCOUNT_SUFFIX="-${ACCOUNT//[.:]/_}"

# ---- native claude pass-through --------------------------------------------
_NATIVE_SUBCMDS="update upgrade mcp auth install setup-token agents doctor ultrareview config plugin plugins project"

# --json is OURS (own-flag parser, above) and is deliberately absent from this
# list, exactly like --version: `claude-session --json` must emit our envelope,
# not run `claude --json`. Claude's own --json is reached with
# `claude-session -- --json`, which _native_is_inline still routes inline.
# Is this argv a native claude invocation (subcommand or session/print flag)?
_is_native_invocation() {
  local first="${1:-}"; shift || true
  case " $_NATIVE_SUBCMDS " in *" $first "*) return 0 ;; esac
  local a
  for a in "$first" "$@"; do
    case "$a" in
      -r|--resume|--resume=*|-c|--continue|--from-pr|-p|--print|\
      --model|--model=*|--agent|--agent=*|--session-id|--session-id=*|--fork-session) return 0 ;;
    esac
  done
  return 1
}

# One-shot (inline) vs interactive (tmux) for a native invocation.
_native_is_inline() {
  local first="${1:-}"; local a
  for a in "$@"; do case "$a" in -p|--print|--version|--json) return 0 ;; esac; done
  case "$first" in
    update|upgrade|install|setup-token|mcp) return 0 ;;
    auth) [[ "${2:-}" == "status" ]] && return 0; return 1 ;;
  esac
  return 1
}

# Launch `claude <args…>` in a durable tmux session, then enter it.
# _launch_native <sess> <dir> <acct_config_dir> -- <claude args…>
_launch_native() {
  local sess="$1" dir="$2" acct_dir="$3"; shift 3
  [[ "${1:-}" == "--" ]] && shift
  command -v claude >/dev/null 2>&1 || { echo "claude-session: 'claude' not in PATH" >&2; exit 1; }
  local claude_cmd exit_message fallback_shell env_prefix
  printf -v claude_cmd '%q ' claude "$@"
  printf -v exit_message '%q' '[claude-session] Claude exited — run claude again or Ctrl-D to close.'
  printf -v fallback_shell '%q' "${SHELL:-bash}"
  env_prefix=""
  [[ -n "$acct_dir" ]] && printf -v env_prefix 'CLAUDE_CONFIG_DIR=%q ' "$acct_dir"
  tmux new-session -d -s "$sess" -c "$dir" \
    "$env_prefix$claude_cmd; printf '\\n%s\\n' $exit_message; exec $fallback_shell"
  _enter_session "$sess"
}

# Forward a native invocation: inline (exec) or tmux, honoring --account.
_dispatch_native() {
  local -a nargs=("$@")
  local acct_dir=""; [[ -n "$ACCOUNT" && "$ACCOUNT" != "default" ]] && acct_dir="$ACCOUNT_DIR"
  if _native_is_inline "${nargs[@]+"${nargs[@]}"}"; then
    command -v claude >/dev/null 2>&1 || { echo "claude-session: 'claude' not in PATH" >&2; exit 1; }
    if [[ -n "$acct_dir" ]]; then exec env CLAUDE_CONFIG_DIR="$acct_dir" claude "${nargs[@]+"${nargs[@]}"}"; else exec claude "${nargs[@]+"${nargs[@]}"}"; fi
  fi
  local dir; dir="$(pwd)"
  local sbase; sbase="$(basename "$dir")"; sbase="${sbase//[.:]/_}"
  local sess="$sbase-claude$ACCOUNT_SUFFIX"
  # A session already running under this name does NOT mean the request is
  # satisfied. The caller asked for something specific — `--resume <sid>`,
  # `--continue`, a model override — and attaching to a pre-existing session
  # delivers none of it. This used to call _enter_session here, which execs and
  # therefore discarded every native argument without a word: you asked to
  # resume one chat and silently landed in whatever chat happened to be open in
  # this directory. Since the session name is just the cwd basename, any earlier
  # session in the same directory hijacked the request.
  #
  # Give the request its own session instead, and say where it went.
  if tmux has-session -t "$sess" 2>/dev/null; then
    local base="$sess" n=2
    while tmux has-session -t "$sess" 2>/dev/null; do sess="$base-$n"; n=$((n + 1)); done
    printf "claude-session: '%s' is already running — opening this request as '%s'\n" "$base" "$sess" >&2
    printf "  to attach to the existing one instead:  tmux attach -t %s\n" "$base" >&2
  fi
  _launch_native "$sess" "$dir" "$acct_dir" -- "${nargs[@]+"${nargs[@]}"}"
}

_json_guard "${a1:-}"

case "$a1" in
  ls)       cmd_ls;     exit 0 ;;
  resume)   cmd_resume; exit 0 ;;
  doctor)   cmd_doctor; exit $? ;;
  accounts) cmd_accounts "${@:2}"; exit 0 ;;
  transfer) cmd_transfer "${@:2}"; _transfer_maybe_launch; exit 0 ;;
  schedule)      cmd_schedule "${@:2}"; exit 0 ;;
  _schedule-run) cmd_schedule_run "$a2"; exit $? ;;
  _snapshot) cmd_snapshot; exit $? ;;   # internal: one envelope per poll cycle, for the app (lib/json.sh)
  _preview) _preview_for_sid "$a2" "${3:-}" "$(_account_dir_or_default "${4:-default}")"; exit 0 ;;   # internal: fzf preview hook (sid, cwd, account)
  _titles)
    (( JSON_OUT == 1 )) || { echo "claude-session _titles: requires --json" >&2; exit 2; }
    if (( TI_REBUILD == 1 )); then
      # The ONLY full build. Measured (hermetic fake HOME, real CLI, synthetic
      # two-line transcripts): 1,000 transcripts in 39.35s, 2,000 in 71.33s —
      # ~35-39ms each. Linearly extrapolated to this host's actual 6,810
      # transcripts, that's ~240s (~4 minutes), not the ~54s an earlier
      # version of this comment claimed. Either way it is never reached from
      # a listing path — a user waiting for a list must never wait for a
      # cache. The app offers it as an explicit action that hands over the
      # terminal (Task 18), and install.sh only ever suggests it.
      _ti_rebuild || exit 1
      printf '{"schemaVersion":%s,"rebuilt":true,"entries":%s}\n' "$JSON_SCHEMA_VERSION" \
        "$(awk 'NR>1' "$TITLE_INDEX" | wc -l | tr -d ' ')"
      exit 0
    fi
    # `IFS=',' read -ra`, never a bare unquoted `${SNAP_SIDS//,/ }`: the latter
    # is word-split AND glob-expanded, and this string comes straight off a
    # CLI flag. A sid containing `*` (sids are UUIDs in practice, but nothing
    # stops a caller from passing anything) would expand against the CURRENT
    # DIRECTORY before `_titles_window` ever saw it, silently turning one
    # requested sid into whatever unrelated filenames happened to match.
    # `read -ra` splits on the comma without ever consulting pathname
    # expansion, and produces an empty array (not one empty-string element)
    # when $SNAP_SIDS is unset/empty, matching the previous no-flag behavior.
    _tw_sids=()
    IFS=',' read -ra _tw_sids <<< "$SNAP_SIDS"
    _titles_window "$(_account_dir_or_default "${ACCOUNT:-default}")" "${_tw_sids[@]+"${_tw_sids[@]}"}"
    exit $? ;;
  kill)
    if [[ -z "$a2" ]]; then cmd_kill; else tmux kill-session -t "$a2"; fi
    exit 0 ;;
esac

if (( SHOW_VERSION == 1 )); then
  printf 'claude-session %s\n' "$VERSION"
  printf '  platform   %s (%s)\n' "$(_compat_os)" "$(uname -sr 2>/dev/null)"
  printf '  bash       %s\n' "${BASH_VERSION:-unknown}"
  printf '  lib        %s\n' "$CLAUDE_HELPERS_LIB"
  printf '  claude     %s\n' "$(command -v claude >/dev/null 2>&1 && claude --version 2>/dev/null | head -1 || echo 'not found')"
  printf '\nfor Claude Code'"'"'s own version:  claude-session -- --version\n'
  exit 0
fi

# Native claude pass-through (after own verbs, before project resolution).
if (( PASSTHROUGH == 1 )); then
  _dispatch_native "${NATIVE_ARGS[@]+"${NATIVE_ARGS[@]}"}"; exit $?
fi
if [[ -n "$a1" ]] && ! [[ -d "$HOME/$a1" ]] && _is_native_invocation "$@"; then
  _nat=("$@")
  (( PLAIN == 1 )) && _nat+=(-p)
  _dispatch_native "${_nat[@]+"${_nat[@]}"}"; exit $?
fi

# Resolve PROJECT + DIR from positional args / cwd.
if [[ -n "$a1" && "$a1" != "new" && ! "$a1" =~ ^[0-9]+$ && -d "$HOME/$a1" ]]; then
  PROJECT="$a1"; DIR="$HOME/$a1"; SUFFIX="$a2"
else
  DIR="$(pwd)"; PROJECT="$(basename "$DIR")"; SUFFIX="$a1"
fi
[[ -d "$DIR" ]] || { echo "claude-session: no such dir: $DIR" >&2; exit 1; }

# tmux silently rewrites '.' and ':' to '_' in stored session names, but treats
# them as window/pane separators inside a `-t` target. A project whose name
# contains them (e.g. "my.site-system") thus gets created fine yet can never
# be attached/matched ("can't find window: my"). Sanitize to match tmux.
SBASE="${PROJECT//[.:]/_}"
SESS="$SBASE-claude$ACCOUNT_SUFFIX"
if [[ "$SUFFIX" == "new" ]]; then
  n=1; while tmux has-session -t "$SBASE-claude$ACCOUNT_SUFFIX-$n" 2>/dev/null; do n=$((n+1)); done
  SESS="$SBASE-claude$ACCOUNT_SUFFIX-$n"
elif [[ "$SUFFIX" =~ ^[0-9]+$ ]]; then
  SESS="$SBASE-claude$ACCOUNT_SUFFIX-$SUFFIX"
fi

command -v claude >/dev/null 2>&1 || { echo "claude-session: 'claude' not in PATH" >&2; exit 1; }

if tmux has-session -t "$SESS" 2>/dev/null; then
  echo "claude-session: re-attaching '$SESS'" >&2
  _enter_session "$SESS"
fi

acct_disp=""
acct_flag=""
if [[ -n "$ACCOUNT" && "$ACCOUNT" != "default" ]]; then
  acct_disp=" (account: $ACCOUNT)"
  acct_flag=" --account=$ACCOUNT"
fi

if (( FORCE == 0 )); then
  if existing="$(_project_already_bridged "$DIR" "${ACCOUNT:-default}")"; then
    cat >&2 <<MSG
${R}claude-session: refusing to start '$SESS'.${N}
  Another Claude session for $(short_home "$DIR")$acct_disp already owns the Remote Control bridge:
    $existing
  Options:
    - reattach:         claude-session $PROJECT$acct_flag          (uses tmux attach)
    - explicit second:  claude-session $PROJECT new$acct_flag      (will warn again)
    - force this one:   claude-session $PROJECT ${SUFFIX:-}$acct_flag --force
  Diagnose:  claude-session doctor
MSG
    exit 2
  fi
fi

echo "claude-session: starting '$SESS' in $DIR$acct_disp  (inside: /rc phone, /ide VSCode)" >&2
claude_args=()
if [[ -n "$HANDOFF" ]]; then
  handoff_dir="$(dirname "$HANDOFF")"
  case "$CLAUDE_MODE" in
    plan)      claude_args+=(--permission-mode plan) ;;
    autopilot) claude_args+=(--permission-mode acceptEdits) ;;
  esac
  claude_args+=(--add-dir "$handoff_dir")
  claude_args+=("Take over the prior agent session documented in $HANDOFF. Read the handoff completely before acting. Inspect the current cwd, branch, HEAD, and git status; compare them with the handoff; then respond with a HANDOFF ACK containing verified completed work, stale or conflicting claims, remaining priorities, and the first proposed check. Do not modify files or run mutating commands until the user confirms.")
fi
_launch_native "$SESS" "$DIR" "$ACCOUNT_DIR" -- "${claude_args[@]+"${claude_args[@]}"}"
